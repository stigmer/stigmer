{
  "name": "stigmer-site",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@4.5.1",
  "engines": {
    "node": "^20.11.0 || ^22.0.0"
  },
  "scripts": {
    "dev": "tsx scripts/copy-narration-to-public.ts && next dev",
    "generate-images": "tsx scripts/generate-images.ts",
    "build": "tsx scripts/copy-narration-to-public.ts && tsx scripts/generate-images.ts && next build && tsx scripts/generate-llms-txt.ts",
    "generate-llms": "tsx scripts/generate-llms-txt.ts",
    "generate-narration": "tsx scripts/generate-narration.ts",
    "copy-narration": "tsx scripts/copy-narration-to-public.ts",
    "validate-demos": "tsx scripts/validate-demos.ts",
    "generate-react-sdk-docs": "tsx scripts/generate-react-sdk-docs/index.ts",
    "generate-ink-sdk-docs": "tsx scripts/generate-ink-sdk-docs/index.ts",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:demos": "playwright test --project=desktop",
    "test:demos:visibility": "playwright test e2e/demos/demo-visibility.spec.ts --project=desktop --project=ipad",
    "test:demos:all-viewports": "playwright test --project=desktop --project=ipad",
    "test:demos:update-snapshots": "playwright test e2e/demos/demo-visibility.spec.ts --project=desktop --project=ipad --update-snapshots"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@bufbuild/protobuf": "^2.11.0",
    "@connectrpc/connect": "^2.1.1",
    "@orama/orama": "^3.1.18",
    "@radix-ui/react-slot": "^1.2.3",
    "@scenar/core": "0.1.19",
    "@scenar/preview": "0.1.19",
    "@scenar/react": "0.1.19",
    "@stigmer/protos": "file:../apis/stubs/ts",
    "@stigmer/react": "file:../sdk/react",
    "@stigmer/sdk": "file:../sdk/typescript",
    "@stigmer/theme": "file:../sdk/theme",
    "@types/mdx": "^2.0.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.31.1",
    "fumadocs-core": "15.8.5",
    "fumadocs-mdx": "13.0.8",
    "fumadocs-ui": "15.8.5",
    "lucide-react": "^0.469.0",
    "mermaid": "^11.13.0",
    "next": "15.3.9",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-syntax-highlighter": "^16.1.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@next/bundle-analyzer": "^16.1.6",
    "@playwright/test": "^1.59.1",
    "@scenar/cli": "0.1.19",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "edge-tts-universal": "^1.4.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.3.9",
    "gray-matter": "^4.0.3",
    "msw": "^2.7.3",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2"
  }
}
