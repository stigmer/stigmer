// The website's two Cloudflare Workers, both the static export in ./out and nothing else: no code runs
// in either. stigmer.ai is served by the router in front of it, which hands the apex to `stigmer-website`
// through a service binding, redirects www to the apex, and answers each pull request's review site,
// a version of `stigmer-website-preview`, at review-<n>.stigmer.ai.
//
//   production:    .github/workflows/release.website.yaml  -> wrangler deploy
//   review sites:  .github/workflows/publish.website-preview.yaml  -> wrangler versions upload --env preview --preview-alias review-<n>
//                  (the export built, with no key, by .github/workflows/preview.website.yaml)
//
// Both run the pinned wrangler in ./deploy, with a key scoped to its one Worker.
{
  "$schema": "./deploy/node_modules/wrangler/config-schema.json",
  "name": "stigmer-website",
  // The stigmer Cloudflare account, where the router and the stigmer.ai zone live.
  "account_id": "7c7ea956f8c8baf24e2d77f01141a838",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    // A path the export has no file for gets the site's own 404 page, as GitHub Pages served it.
    "not_found_handling": "404-page",
    // /pricing serves pricing.html, the export's file for it.
    "html_handling": "auto-trailing-slash"
  },
  // No address of its own: only the router reaches production, so the website is never served twice.
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "preview": {
      // Only ever review sites: each is a version aliased review-<n>, at
      // review-<n>-stigmer-website-preview.stigmer.workers.dev, behind review-<n>.stigmer.ai.
      "name": "stigmer-website-preview",
      "workers_dev": false,
      "preview_urls": true
    }
  }
}
