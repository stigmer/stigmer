{
  "version": "1",
  "description": "Machine-readable content requirements for the Stigmer sales website. Defines what every page type and section type MUST contain. Used by lint tooling (site/scripts/lint-pages.ts) and Cursor rules (.cursor/rules/site/) to enforce structural quality.",
  "page_types": {
    "homepage": {
      "purpose": "First impression and hub to all visitor journeys",
      "funnel_stages": ["awareness", "interest", "action"],
      "personas": ["all"],
      "required_sections": ["hero", "features", "how-it-works", "quickstart", "cta-band"],
      "required_metadata": ["title", "description", "og:title", "og:description", "og:image", "og:url", "twitter:card"],
      "must_link_to": ["use-case", "feature", "quickstart"],
      "success_metric": "Scroll depth > 60%, click-through to use-case or quickstart"
    },
    "use-case": {
      "purpose": "Persona-specific problem-to-solution story",
      "funnel_stages": ["interest", "evaluation"],
      "personas": ["specific"],
      "required_sections": ["hero", "problem", "solution", "proof", "cta-band"],
      "required_metadata": ["title", "description", "og:title", "og:description", "og:image", "og:url", "twitter:card", "persona"],
      "must_link_to": ["feature", "comparison", "quickstart"],
      "success_metric": "Click-through to quickstart or install command"
    },
    "comparison": {
      "purpose": "Honest Stigmer-vs-X technical evaluation",
      "funnel_stages": ["evaluation"],
      "personas": ["engineering-leader", "solo-developer"],
      "required_sections": ["hero", "comparison", "when-to-use-each", "cta-band"],
      "required_metadata": ["title", "description", "og:title", "og:description", "og:image", "og:url", "twitter:card"],
      "must_link_to": ["feature", "quickstart", "pricing"],
      "success_metric": "Click-through to quickstart or feature page"
    },
    "feature": {
      "purpose": "Deep-dive on a major capability",
      "funnel_stages": ["interest", "evaluation"],
      "personas": ["all"],
      "required_sections": ["hero", "explanation", "code-showcase", "benefits", "cta-band"],
      "required_metadata": ["title", "description", "og:title", "og:description", "og:image", "og:url", "twitter:card"],
      "must_link_to": ["use-case", "feature", "docs"],
      "success_metric": "Click-through to quickstart or docs"
    },
    "landing": {
      "purpose": "Campaign or launch conversion page",
      "funnel_stages": ["awareness", "action"],
      "personas": ["campaign-specific"],
      "required_sections": ["hero", "key-message", "social-proof", "cta-band"],
      "required_metadata": ["title", "description", "og:title", "og:description", "og:image", "og:url", "twitter:card"],
      "must_link_to": ["quickstart", "feature"],
      "success_metric": "Campaign-specific conversion action"
    },
    "pricing": {
      "purpose": "Pricing tiers and feature breakdown",
      "funnel_stages": ["evaluation", "action"],
      "personas": ["engineering-leader", "platform-builder"],
      "required_sections": ["hero", "tier-comparison", "faq", "cta-band"],
      "required_metadata": ["title", "description", "og:title", "og:description", "og:image", "og:url", "twitter:card"],
      "must_link_to": ["quickstart", "feature", "faq"],
      "success_metric": "Click-through to quickstart (OSS) or Cloud signup"
    },
    "changelog": {
      "purpose": "Release notes and migration guides",
      "funnel_stages": ["interest"],
      "personas": ["existing-users", "evaluators"],
      "required_sections": ["release-entries"],
      "required_metadata": ["title", "description", "og:title", "og:description", "og:url"],
      "must_link_to": ["feature", "docs"],
      "success_metric": "Return visit, version adoption"
    },
    "blog": {
      "purpose": "Technical posts, tutorials, and announcements",
      "funnel_stages": ["awareness", "interest"],
      "personas": ["all"],
      "required_sections": ["title-block", "content", "related-posts"],
      "required_metadata": ["title", "description", "og:title", "og:description", "og:image", "og:url", "twitter:card", "author", "date"],
      "must_link_to": ["blog", "feature", "use-case", "docs"],
      "success_metric": "Click-through to related post or quickstart"
    },
    "community": {
      "purpose": "Community resources and contribution paths",
      "funnel_stages": ["interest", "action"],
      "personas": ["all"],
      "required_sections": ["hero", "contribution-paths", "resources", "cta-band"],
      "required_metadata": ["title", "description", "og:title", "og:description", "og:image", "og:url", "twitter:card"],
      "must_link_to": ["github", "contributing", "quickstart", "docs"],
      "success_metric": "GitHub star, Discord join, or contribution"
    }
  },
  "section_types": {
    "hero": {
      "job": "Hook — earn the scroll",
      "required_elements": ["headline", "subheadline", "primary_cta", "secondary_cta", "visual_anchor"],
      "constraints": {
        "max_headline_words": 8,
        "above_fold": true,
        "visual_anchor_type": ["code_snippet", "terminal_mockup", "badge_cluster"],
        "visual_anchor_prohibited": ["stock_image"]
      }
    },
    "features": {
      "job": "Educate — what does it do, and why should I care?",
      "required_elements": ["benefit_first_description", "icon_or_visual", "proof_point"],
      "constraints": {
        "min_features": 3,
        "max_features": 6,
        "description_style": "benefit_first",
        "proof_point_type": ["code_snippet", "metric", "link"]
      }
    },
    "how-it-works": {
      "job": "Build trust — show it is well-built",
      "required_elements": ["numbered_steps", "code_or_diagram"],
      "constraints": {
        "min_steps": 3,
        "max_steps": 5,
        "progressive_disclosure": true,
        "min_artifacts_per_step": 1
      }
    },
    "code-showcase": {
      "job": "Prove — show it works",
      "required_elements": ["minimal_example", "syntax_highlighting", "copy_button", "context_label"],
      "constraints": {
        "language_tag_required": true,
        "self_explanatory": true,
        "context_label_position": "above"
      }
    },
    "comparison": {
      "job": "Handle objections — why this over alternatives?",
      "required_elements": ["honest_positioning", "specific_differences", "when_to_use_each"],
      "constraints": {
        "must_acknowledge_competitor_strengths": true,
        "differences_must_be_technical": true,
        "no_misrepresentation": true
      }
    },
    "social-proof": {
      "job": "Validate — who else uses this?",
      "required_elements": ["real_metrics", "verifiable_claims"],
      "constraints": {
        "metrics_must_be_auditable": true,
        "metrics_must_be_current": true,
        "no_vanity_metrics": true
      }
    },
    "cta-band": {
      "job": "Convert — make the next step obvious",
      "required_elements": ["headline", "supporting_copy", "primary_cta", "secondary_cta"],
      "constraints": {
        "max_supporting_copy_sentences": 2,
        "primary_cta_action_text": true,
        "placement": ["end_of_major_section", "page_bottom"]
      }
    },
    "faq": {
      "job": "Address remaining objections",
      "required_elements": ["real_questions", "concise_answers"],
      "constraints": {
        "max_answer_sentences": 3,
        "must_link_to_docs_for_depth": true,
        "structured_data_required": true,
        "structured_data_schema": "FAQPage"
      }
    }
  },
  "funnel_stages": ["awareness", "interest", "evaluation", "action"],
  "personas": {
    "solo-developer": {
      "label": "Solo developer / indie hacker",
      "motivation": "Ship AI features fast, minimal infra",
      "primary_objection": "Is it production-ready? Will I get locked in?"
    },
    "platform-builder": {
      "label": "Platform team lead",
      "motivation": "Embed agentic capabilities into their product",
      "primary_objection": "How does this integrate with our stack?"
    },
    "engineering-leader": {
      "label": "Engineering manager / architect",
      "motivation": "Evaluate build-vs-buy for agent infrastructure",
      "primary_objection": "How does this compare to X?"
    }
  },
  "global_rules": {
    "min_internal_links_per_page": 2,
    "max_internal_links_per_page": 3,
    "no_dead_end_pages": true,
    "every_section_must_have_job": true,
    "every_page_must_have_audience": true,
    "every_page_must_have_goal": true,
    "every_page_must_have_success_metric": true
  }
}
