# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
# The site installs with yarn (yarn.lock); npm's lockfile is never this folder's
/package-lock.json

# Testing
/coverage

# Next.js
/.next/
/out/

# Fumadocs (generated content source)
/.source/

# Production
/build

# Misc
.DS_Store
*.pem

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files
.env*

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Screens, converted at build time from the visual suite's approved pictures
# (scripts/generate-screens.ts)
/public/screens/

# Search index (generated at build time)
out/_pagefind/
public/_pagefind/
