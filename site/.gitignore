# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage
/e2e/screenshots/
/e2e/demos/demo-manifest.json
# Demo screenshot baselines are per-machine (self-baselined on first
# run, regenerated via test:demos:update-snapshots); no CI consumes
# them, so committing the PNGs would only churn the repo.
/e2e/demos/*-snapshots/
/playwright-report/
/test-results/

# Next.js
/.next/
/out/

# Fumadocs (generated content source)
/.source/

# Production
/build

# Misc
.DS_Store
*.pem

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files
.env*

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Search index (generated at build time)
out/_pagefind/
public/_pagefind/

# Narration build artifacts (regenerated by copy-narration-to-public)
public/demos/

# Narration build-script cache (not needed for deployment)
**/narration/.narration-cache.json
