{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "to": {
      "additionalProperties": false,
      "description": "Signal listening configuration.",
      "properties": {
        "mode": {
          "description": "Listening mode: - \"one\": Wait for any one signal - \"all\": Wait for all signals",
          "type": "string"
        },
        "signals": {
          "description": "Signals to listen for.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "description": "Signal identifier.",
                "minLength": 1,
                "type": "string"
              },
              "type": {
                "description": "Signal type: \"signal\", \"query\", or \"update\".",
                "type": "string"
              }
            },
            "required": [
              "id",
              "type"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "mode"
      ],
      "type": "object"
    }
  },
  "required": [
    "to"
  ],
  "title": "ListenTaskConfig",
  "type": "object"
}