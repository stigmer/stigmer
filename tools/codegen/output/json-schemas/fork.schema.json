{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "branches": {
      "description": "Branches to execute in parallel (at least 2 required).",
      "items": {
        "additionalProperties": false,
        "properties": {
          "do": {
            "description": "Tasks to execute in this branch.",
            "items": {
              "additionalProperties": false,
              "properties": {
                "compensate": {
                  "description": "Compensation tasks to execute if this task needs to be \"undone.\"",
                  "items": {
                    "type": "object"
                  },
                  "type": "array"
                },
                "export": {
                  "additionalProperties": false,
                  "description": "Export configuration (how to save task output to context). Optional - if not set, output is not saved.",
                  "properties": {
                    "as": {
                      "description": "Expression defining how to export output using ${...} syntax.",
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "flow": {
                  "additionalProperties": false,
                  "description": "Flow control (which task executes next). Optional - if not set, continues to next task in sequence.",
                  "properties": {
                    "then": {
                      "description": "Target task name or \"end\" to terminate workflow.",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "kind": {
                  "description": "Task type (determines how to interpret task_config).",
                  "enum": [
                    "set_vars",
                    "http_call",
                    "grpc_call",
                    "activity_call",
                    "switch_case",
                    "for_each",
                    "fork",
                    "try_catch",
                    "listen",
                    "wait",
                    "raise_error",
                    "run_workflow",
                    "agent_call",
                    "llm_call",
                    "transform",
                    "human_input",
                    "validate",
                    "emit_event",
                    "notification",
                    "eval"
                  ],
                  "type": "string"
                },
                "name": {
                  "description": "Task name/identifier (must be unique within workflow). Must be a valid C-style identifier: starts with a letter or underscore, followed by letters, digits, or underscores.",
                  "minLength": 1,
                  "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$",
                  "type": "string"
                },
                "task_config": {
                  "description": "Task-specific configuration whose structure depends on the `kind` field.",
                  "type": "object"
                }
              },
              "required": [
                "kind",
                "task_config"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "name": {
            "description": "Branch name/identifier.",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "minItems": 2,
      "type": "array"
    },
    "compete": {
      "description": "If true, first branch to complete wins (race mode). If false, all branches must complete (default).",
      "type": "boolean"
    }
  },
  "title": "ForkTaskConfig",
  "type": "object"
}