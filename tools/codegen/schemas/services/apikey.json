{
  "resource": "apikey",
  "package": "ai.stigmer.iam.apikey.v1",
  "goImportPath": "apikeyv1",
  "services": [
    {
      "name": "ApiKeyCommandController",
      "role": "command",
      "methods": [
        {
          "name": "Create",
          "inputType": "ApiKey",
          "inputFullType": "ai.stigmer.iam.apikey.v1.ApiKey",
          "outputType": "ApiKey",
          "outputFullType": "ai.stigmer.iam.apikey.v1.ApiKey",
          "description": "Create a new API key for the authenticated user.\n Any authenticated user can create API keys."
        },
        {
          "name": "Update",
          "inputType": "ApiKey",
          "inputFullType": "ai.stigmer.iam.apikey.v1.ApiKey",
          "outputType": "ApiKey",
          "outputFullType": "ai.stigmer.iam.apikey.v1.ApiKey",
          "description": "Update an existing API key."
        },
        {
          "name": "Delete",
          "inputType": "ApiKeyId",
          "inputFullType": "ai.stigmer.iam.apikey.v1.ApiKeyId",
          "outputType": "ApiKey",
          "outputFullType": "ai.stigmer.iam.apikey.v1.ApiKey",
          "description": "Delete an API key."
        }
      ]
    },
    {
      "name": "ApiKeyQueryController",
      "role": "query",
      "methods": [
        {
          "name": "Get",
          "inputType": "ApiKeyId",
          "inputFullType": "ai.stigmer.iam.apikey.v1.ApiKeyId",
          "outputType": "ApiKey",
          "outputFullType": "ai.stigmer.iam.apikey.v1.ApiKey",
          "description": "Get an API key by its unique identifier."
        },
        {
          "name": "GetByKeyHash",
          "inputType": "ApiKeyHash",
          "inputFullType": "ai.stigmer.iam.apikey.v1.ApiKeyHash",
          "outputType": "ApiKey",
          "outputFullType": "ai.stigmer.iam.apikey.v1.ApiKey",
          "description": "Get an API key by its hashed key value.\n\n @internal\n Authorization is handled in the handler after loading the resource\n (input doesn't contain API key ID, so proto-level auth cannot work)."
        },
        {
          "name": "FindAll",
          "inputType": "Empty",
          "inputFullType": "google.protobuf.Empty",
          "outputType": "ApiKeys",
          "outputFullType": "ai.stigmer.iam.apikey.v1.ApiKeys",
          "description": "List all API keys belonging to the authenticated user."
        }
      ]
    }
  ]
}