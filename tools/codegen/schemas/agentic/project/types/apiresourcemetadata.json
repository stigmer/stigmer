{
  "name": "ApiResourceMetadata",
  "description": "ApiResourceMetadata contains standard metadata for all API resources.\n Every resource belongs to an organization and has a visibility setting.",
  "protoType": "ai.stigmer.commons.apiresource.ApiResourceMetadata",
  "protoFile": "apis/ai/stigmer/commons/apiresource/metadata.proto",
