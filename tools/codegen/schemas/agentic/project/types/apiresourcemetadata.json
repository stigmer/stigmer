      "required": false
    },
    {
      "name": "Org",
      "jsonName": "org",
      "protoField": "org",
      "type": {
        "kind": "string"
      },
      "description": "Organization that owns this resource.\n In Local Mode: Defaults to \"default\" org.\n In Cloud Mode: Required and enforced by the Authorization Service.\n All resources belong to exactly one organization.",
      "required": false
    },
    {
      "name": "Visibility",
      "jsonName": "visibility",
      "protoField": "visibility",
      "type": {
        "kind": "string",
        "enumType": "ai.stigmer.commons.apiresource.ApiResourceVisibility",
        "enumValues": [
          "visibility_private",
          "visibility_public"
        ]
      },
      "description": "Visibility controls who can access this resource.\n - PRIVATE: Only members of the owning organization can access.\n - PUBLIC: Anyone can access (read). Write access still requires org membership.\n Default: PRIVATE for new resources.",
      "required": false
    },
    {
