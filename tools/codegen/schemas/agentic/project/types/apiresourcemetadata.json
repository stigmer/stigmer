      "jsonName": "name",
      "protoField": "name",
      "type": {
        "kind": "string"
      },
      "description": "Human-readable name of the resource.",
      "required": false
    },
    {
      "name": "Slug",
      "jsonName": "slug",
      "protoField": "slug",
      "type": {
        "kind": "string"
      },
      "description": "URL-friendly identifier, unique within the organization.\n Combined with org, forms the canonical reference: \"org/slug\".",
      "required": false
    },
    {
      "name": "Id",
      "jsonName": "id",
      "protoField": "id",
      "type": {
        "kind": "string"
      },
