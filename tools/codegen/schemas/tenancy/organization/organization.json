{
  "name": "OrganizationSpec",
  "kind": "ORGANIZATION_SPEC",
  "description": "OrganizationSpec defines the configurable properties of an organization.",
  "protoType": "ai.stigmer.tenancy.organization.v1.OrganizationSpec",
  "protoFile": "apis/ai/stigmer/tenancy/organization/v1/spec.proto",
  "fields": [
    {
      "name": "Description",
      "jsonName": "description",
      "protoField": "description",
      "type": {
        "kind": "string"
      },
      "description": "Human-readable description of the organization.",
      "required": false,
      "validation": {
        "maxLength": 500
      }
    },
    {
      "name": "LogoUrl",
      "jsonName": "logoUrl",
      "protoField": "logo_url",
      "type": {
        "kind": "string"
      },
      "description": "Public URL for the organization logo.",
      "required": false,
      "validation": {
        "maxLength": 2048
      }
    },
    {
      "name": "ManagementMode",
      "jsonName": "managementMode",
      "protoField": "management_mode",
      "type": {
        "kind": "string",
        "enumType": "ai.stigmer.tenancy.organization.v1.ManagementMode",
        "enumValues": [
          "self_managed",
          "platform_managed"
        ]
      },
      "description": "How this organization is operated.",
      "required": false
    },
    {
      "name": "IdentityProviderRef",
      "jsonName": "identityProviderRef",
      "protoField": "identity_provider_ref",
      "type": {
        "kind": "message",
        "messageType": "ApiResourceReference"
      },
      "description": "Reference to the IdentityProvider that authenticates requests for this organization.",
      "required": false
    },
    {
      "name": "ExternalOrgId",
      "jsonName": "externalOrgId",
      "protoField": "external_org_id",
      "type": {
        "kind": "string"
      },
      "description": "External platform's organization identifier for reverse mapping.",
      "required": false
    },
    {
      "name": "IsPersonal",
      "jsonName": "isPersonal",
      "protoField": "is_personal",
      "type": {
        "kind": "bool"
      },
      "description": "Whether this is a personal organization, auto-created during identity provisioning.",
      "required": false
    },
    {
      "name": "Preferences",
      "jsonName": "preferences",
      "protoField": "preferences",
      "type": {
        "kind": "message",
        "messageType": "OrganizationPreferences"
      },
      "description": "Standing preferences declared by the organization.",
      "required": false
    }
  ]
}