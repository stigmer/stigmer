# ---------------------------------------------------------------------------
# Stigmer Web — Environment Variables
#
# Copy this file to .env and adjust as needed. The same NEXT_PUBLIC_*
# variable names are used everywhere: local development (`next dev`),
# Docker container deployments (entrypoint.sh generates /config.json
# from these), and Kubernetes (kustomize injects them as env vars).
# ---------------------------------------------------------------------------

# Backend API URL (gRPC-Web endpoint)
NEXT_PUBLIC_API_URL=http://localhost:7234

# Public web app URL for externally shareable links (e.g. shared agent
# chat pages). Leave unset to use the browser's own origin.
# NEXT_PUBLIC_APP_URL=

# Auth mode: "disabled" (default) or "oidc"
NEXT_PUBLIC_AUTH_MODE=disabled

# ---------------------------------------------------------------------------
# OIDC settings — only needed when NEXT_PUBLIC_AUTH_MODE=oidc
# ---------------------------------------------------------------------------

# OIDC issuer URL (e.g., https://your-tenant.us.auth0.com/)
# NEXT_PUBLIC_OIDC_ISSUER=

# OAuth 2.0 SPA client ID
# NEXT_PUBLIC_OIDC_CLIENT_ID=

# API audience for access token scoping
# NEXT_PUBLIC_OIDC_AUDIENCE=https://api.stigmer.com/
