# ---------------------------------------------------------------------------
# Stigmer Web — Local Development Environment Variables
#
# Copy this file to .env.local and adjust as needed. These variables are
# used as fallback values when /config.json is not present (i.e., during
# local development with `next dev`). In container deployments, all
# configuration comes from /config.json generated by the Docker entrypoint.
# ---------------------------------------------------------------------------

# Backend API URL (gRPC-Web endpoint)
NEXT_PUBLIC_API_URL=http://localhost:7234

# Auth mode: "disabled" (default) or "oidc"
NEXT_PUBLIC_AUTH_MODE=disabled

# ---------------------------------------------------------------------------
# OIDC settings — only needed when NEXT_PUBLIC_AUTH_MODE=oidc
# ---------------------------------------------------------------------------

# OIDC issuer URL (e.g., https://your-tenant.us.auth0.com/)
# NEXT_PUBLIC_OIDC_ISSUER=

# OAuth 2.0 SPA client ID
# NEXT_PUBLIC_OIDC_CLIENT_ID=

# API audience for access token scoping
# NEXT_PUBLIC_OIDC_AUDIENCE=https://api.stigmer.com/
