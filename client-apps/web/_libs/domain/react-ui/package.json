{
  "name": "@stigmer/react-ui",
  "version": "0.0.0-dev",
  "description": "React components for Stigmer agent execution streaming, tool calls, and HITL approvals",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./execution": "./src/execution/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && tailwindcss -i src/styles.css -o dist/styles.css --minify",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "stigmer",
    "react",
    "ai-agents",
    "execution-streaming",
    "tool-calls",
    "hitl",
    "human-in-the-loop"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./execution": {
        "types": "./dist/execution/index.d.ts",
        "import": "./dist/execution/index.js"
      },
      "./styles.css": "./dist/styles.css"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stigmer/stigmer.git",
    "directory": "client-apps/web/_libs/domain/react-ui"
  },
  "dependencies": {
    "@stigmer/rpc-client": "*",
    "@stigmer/theme": "*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@stigmer/protos": "*",
    "@base-ui/react": "^1.0.0",
    "@connectrpc/connect": "^2.0.0",
    "@bufbuild/protobuf": "^2.0.0",
    "class-variance-authority": "^0.7.0",
    "lucide-react": ">=0.400.0",
    "react-markdown": "^10.0.0",
    "remark-gfm": "^4.0.0"
  }
}
