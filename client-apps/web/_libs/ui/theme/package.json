{
  "name": "@stigmer/theme",
  "version": "0.0.0-dev",
  "description": "Design tokens, CSS custom properties, and utility functions for Stigmer UI components",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && cp src/tokens.css dist/tokens.css",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "stigmer",
    "theme",
    "design-tokens",
    "tailwindcss",
    "css-variables"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./tokens.css": "./dist/tokens.css"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stigmer/stigmer.git",
    "directory": "client-apps/web/_libs/ui/theme"
  },
  "peerDependencies": {
    "clsx": "^2.0.0",
    "tailwind-merge": "^3.0.0"
  }
}
