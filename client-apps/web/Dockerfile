# Build stage — compile the Next.js static export
FROM public.ecr.aws/docker/library/node:22-alpine AS builder
WORKDIR /app

# No build args — all NEXT_PUBLIC_* configuration is injected at runtime
# via /config.json generated by the entrypoint script from the same
# NEXT_PUBLIC_* environment variables used during local development.

# Copy workspace config and dependency manifests first (layer caching)
COPY package.json package-lock.json ./
COPY apis/stubs/ts/package.json apis/stubs/ts/
COPY sdk/typescript/package.json sdk/typescript/
COPY sdk/theme/package.json sdk/theme/
COPY sdk/react/package.json sdk/react/

# Copy workspace packages the web app depends on
COPY apis/stubs/ts/ apis/stubs/ts/
COPY sdk/typescript/ sdk/typescript/
COPY sdk/theme/ sdk/theme/
COPY sdk/react/ sdk/react/

# Copy the web console source
COPY client-apps/web/ client-apps/web/

# Install dependencies and build
RUN npm ci && \
    npm run build -w @stigmer/protos && \
    npm run build -w client-apps/web

# Runtime stage — nginx serves the static export + runtime config
FROM public.ecr.aws/nginx/nginx:alpine

LABEL org.opencontainers.image.source="https://github.com/stigmer/stigmer"
LABEL org.opencontainers.image.vendor="Stigmer"
LABEL org.opencontainers.image.licenses="Apache-2.0"

COPY --from=builder /app/client-apps/web/out /usr/share/nginx/html
COPY client-apps/web/nginx.conf /etc/nginx/conf.d/default.conf

COPY client-apps/web/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 3000
ENTRYPOINT ["/entrypoint.sh"]
