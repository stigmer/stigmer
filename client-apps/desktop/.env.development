# Local development — connects to local stigmer-service via grpcwebproxy.
# The Java gRPC server runs on :8080, grpcwebproxy exposes gRPC-Web on :9090,
# and Caddy on :9090 routes native gRPC (h2c) to :8080 as well.
VITE_STIGMER_API_URL=http://localhost:9090
VITE_STIGMER_SIDECAR_ENDPOINT=localhost:9090
VITE_STIGMER_FORCE_AUTH=true
VITE_STIGMER_CONSOLE_URL=https://app.stigmer.ai
# Explicit Temporal override for local dev (bypasses runner self-discovery so the
# local loop does not depend on the locally-run service's bootstrap wiring).
# Production omits this and lets the runner discover Temporal from the token.
VITE_STIGMER_TEMPORAL_ADDRESS=stigmer-prod-temporal-frontend.planton.live:7233
# TLS proxy for the embedded runner's Cursor SDK traffic. The SDK requires
# TLS for HTTP/2 (ALPN), which the HTTP/2 interceptor needs to inject
# x-stigmer-auth headers for BiDi proxy authentication.
VITE_STIGMER_RUNNER_PROXY_URL=https://localhost:9093
