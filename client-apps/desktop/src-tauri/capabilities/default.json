{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Base capabilities for Stigmer Desktop",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-show",
    "dialog:default",
    "notifications:default",
    "updater:default",
    "process:default",
    "window-state:default",
    "deep-link:default",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api.stigmer.ai/**" },
        { "url": "https://*.stigmer.ai/**" },
        { "url": "http://localhost:*/**" }
      ]
    }
  ]
}
