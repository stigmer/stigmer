# Production builds — connects to Stigmer Cloud.
VITE_STIGMER_API_URL=https://api.stigmer.ai
VITE_STIGMER_CONSOLE_URL=https://app.stigmer.ai
# Temporal address is intentionally NOT set: the embedded runner self-discovers
# it from the cloud control plane (getRunnerBootstrapConfig) using the auth
# token. Set VITE_STIGMER_TEMPORAL_ADDRESS only to pin it for debugging.
