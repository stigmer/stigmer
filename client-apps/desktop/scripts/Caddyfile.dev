# Local dev reverse proxy for the desktop app.
#
# One listener, :9090 (HTTP): the frontend and runner entry point
# (gRPC-Web, REST, native gRPC).
#
# Routes:
#   /v1/proxy/*        → Java embedded Tomcat on :8081
#   native gRPC        → Java gRPC on :8080 via h2c
#   gRPC-Web / other   → grpcwebproxy on :9091
#
# Requires: grpcwebproxy running on :9091 and Java stigmer-service on :8080/:8081.

:9090 {
	handle /v1/proxy/* {
		reverse_proxy localhost:8081
	}

	@grpcNative {
		header Content-Type application/grpc*
		not header Content-Type application/grpc-web*
	}
	handle @grpcNative {
		reverse_proxy localhost:8080 {
			transport http {
				versions h2c
			}
		}
	}

	handle {
		reverse_proxy localhost:9091
	}
}
