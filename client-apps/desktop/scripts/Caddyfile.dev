# Local dev reverse proxy for the desktop app.
#
# Two listeners:
#
#   :9090 (HTTP)  — Frontend entry point (gRPC-Web, REST, native gRPC).
#   :9093 (HTTPS) — Runner entry point (Connect RPC over HTTP/2).
#
# The Cursor SDK's connect-node transport requires TLS for HTTP/2 (ALPN
# negotiation). Without TLS the SDK uses HTTP/1.1 and the HTTP/2
# interceptor that injects x-stigmer-auth never fires. Port :9093 exists
# solely to provide the TLS termination the SDK needs.
#
# Frontend routes (:9090):
#   /agent.v1*         → Netty BiDi proxy on :8082 via h2c
#   /aiserver.v1*      → Netty BiDi proxy on :8082 via h2c
#   /v1/proxy/*        → Java embedded Tomcat on :8081
#   native gRPC        → Java gRPC on :8080 via h2c
#   gRPC-Web / other   → grpcwebproxy on :9091
#
# Runner routes (:9093):
#   /agent.v1*         → Netty BiDi proxy on :8082 via h2c
#   /aiserver.v1*      → Netty BiDi proxy on :8082 via h2c
#   /v1/proxy/*        → Java embedded Tomcat on :8081
#   everything else    → 404 (runner should not hit other paths)
#
# Requires: grpcwebproxy running on :9091 and Java stigmer-service on :8080/:8081/:8082.
# Requires: TLS cert at scripts/.certs/ (generated by gen-dev-certs.sh).

:9090 {
	handle /agent.v1* {
		reverse_proxy localhost:8082 {
			transport http {
				versions h2c
			}
		}
	}

	handle /aiserver.v1* {
		reverse_proxy localhost:8082 {
			transport http {
				versions h2c
			}
		}
	}

	handle /v1/proxy/* {
		reverse_proxy localhost:8081
	}

	@grpcNative {
		header Content-Type application/grpc*
		not header Content-Type application/grpc-web*
	}
	handle @grpcNative {
		reverse_proxy localhost:8080 {
			transport http {
				versions h2c
			}
		}
	}

	handle {
		reverse_proxy localhost:9091
	}
}

# Runner TLS proxy — enables HTTP/2 for Cursor SDK Connect RPC.
https://localhost:9093 {
	tls client-apps/desktop/scripts/.certs/localhost.pem client-apps/desktop/scripts/.certs/localhost-key.pem

	handle /agent.v1* {
		reverse_proxy localhost:8082 {
			transport http {
				versions h2c
			}
		}
	}

	handle /aiserver.v1* {
		reverse_proxy localhost:8082 {
			transport http {
				versions h2c
			}
		}
	}

	handle /v1/proxy/* {
		reverse_proxy localhost:8081
	}

	handle {
		respond "Not Found" 404
	}
}
