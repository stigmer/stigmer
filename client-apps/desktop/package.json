{
  "name": "desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "tsx ../../sdk/react/scripts/build-styles.ts",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --features dev-notifications",
    "generate:icons": "tsx scripts/generate-icons.ts",
    "test": "npm run test:scripts && vitest run",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@choochmeque/tauri-plugin-notifications-api": "0.5.0-rc.14",
    "@stigmer/apis": "*",
    "@stigmer/client": "*",
    "@stigmer/design-tokens": "*",
    "@stigmer/react-sdk": "*",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-deep-link": "^2.6.3",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-http": "^2.8.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "lucide-react": "^0.577.0",
    "mermaid": "^11.17.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/typescript-checker": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/parser": "^8",
    "@vitejs/plugin-react": "^4",
    "eslint": "^9",
    "eslint-plugin-stigmer": "*",
    "happy-dom": "^20.8.4",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite": "^6",
    "vitest": "^5.1.0"
  }
}
