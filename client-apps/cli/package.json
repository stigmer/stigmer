{
  "name": "@stigmer/cli",
  "version": "0.0.0-dev",
  "description": "Command-line interface for Stigmer, the open-source backend for the agents in your product",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "stigmer": "./dist/cli/stigmer.js"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "tsx src/cli/stigmer.ts",
    "typecheck": "tsc --noEmit",
    "gen-docs": "tsx scripts/gen-cli-docs.ts --output ../../docs/cli/commands/",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "stigmer",
    "cli",
    "ai-agents",
    "grpc"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
      "stigmer": "./dist/cli/stigmer.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stigmer/stigmer.git",
    "directory": "client-apps/cli"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.0.0",
    "@connectrpc/connect": "^2.0.0",
    "@connectrpc/connect-node": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@stigmer/apis": "*",
    "@stigmer/artifact-fetch": "*",
    "@stigmer/client": "*",
    "@stigmer/ink-ui": "*",
    "@stigmer/mcp-server": "*",
    "@stigmer/plugin-package": "*",
    "@stigmer/react-core": "*",
    "@stigmer/zip-structure": "*",
    "commander": "^15.0.0",
    "fflate": "^0.8.3",
    "ink": "^7.0.0",
    "open": "^10.1.0",
    "react": "^19.0.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@stigmer/react-sdk": "*",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/typescript-checker": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.19.4",
    "vitest": "^3.2.4"
  }
}
