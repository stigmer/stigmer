load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "gen-cli-docs_lib",
    srcs = ["main.go"],
    importpath = "github.com/stigmer/stigmer/client-apps/cli/cmd/gen-cli-docs",
    visibility = ["//visibility:private"],
    deps = [
        "//client-apps/cli/cmd/stigmer",
        "@com_github_spf13_cobra//:cobra",
        "@com_github_spf13_pflag//:pflag",
    ],
)

go_binary(
    name = "gen-cli-docs",
    embed = [":gen-cli-docs_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "gen-cli-docs_test",
    srcs = ["coverage_test.go"],
    embed = [":gen-cli-docs_lib"],
    deps = [
        "//client-apps/cli/cmd/stigmer",
        "@com_github_spf13_cobra//:cobra",
        "@com_github_spf13_pflag//:pflag",
    ],
)
