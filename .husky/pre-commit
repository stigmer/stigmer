# Prettier via lint-staged (only when staged docs or agent-guidance files exist;
# lint-staged's own config in package.json decides what runs on each set)
if git diff --cached --name-only -- 'docs/**/*.md' 'docs/**/*.mdx' 'AGENTS.md' ':(glob)**/AGENTS.md' '.agents/**/*.md' | grep -q .; then
  npx lint-staged
fi

# Vale on staged docs files (graceful degradation if not installed).
# docs/AGENTS.md is a package guide, not a docs page: it belongs to the
# guidance lane (GUIDANCE_SOURCES in the Makefile) and is excluded here for the
# same reason it is excluded from DOCS_SOURCES.
if command -v vale >/dev/null 2>&1; then
  STAGED_DOCS=$(git diff --cached --name-only --diff-filter=ACM -- 'docs/*.md' 'docs/*.mdx' ':!docs/AGENTS.md' | grep -v '_archive/' || true)
  if [ -n "$STAGED_DOCS" ]; then
    vale sync 2>/dev/null
    echo "$STAGED_DOCS" | xargs vale
  fi
else
  echo "⚠ Vale not installed — skipping prose lint. Run 'make setup' to install."
fi
