{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stigmer.ai/testdata/hitl/scenario.schema.json",
  "title": "HITL pending-approval projection scenario",
  "description": "A cross-edition fixture: protojson inputs and the expected pending_approvals both editions must project from them.",
  "type": "object",
  "required": ["name", "input", "expected"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "messages": {
          "type": "array",
          "description": "AgentMessage protos as protojson.",
          "items": { "type": "object" }
        },
        "sub_agent_executions": {
          "type": "array",
          "description": "SubAgentExecution protos as protojson.",
          "items": { "type": "object" }
        }
      }
    },
    "expected": {
      "type": "object",
      "required": ["pending_approvals"],
      "additionalProperties": false,
      "properties": {
        "pending_approvals": {
          "type": "array",
          "description": "PendingApproval protos as protojson; compared order-independently by tool_call_id.",
          "items": { "type": "object" }
        },
        "approval_events": {
          "type": "array",
          "description": "Optional. ApprovalEvent protos as protojson. Omitted in Phase 1 (see README).",
          "items": { "type": "object" }
        }
      }
    }
  }
}
