{
  "description": "Cross-reader HITL lease-scope derivation vectors. Given a tool call's (toolName, mcpServerSlug, policySource, policyHook), every reader must derive the same APPROVE_ALL lease scope: {\"hook\": <plugin slug, empty for the agent's own block>, \"tool\": <name>, \"server\": <slug or empty>} when a hook asked (policySource APPROVAL_POLICY_SOURCE_HOOK); otherwise {\"category\": <write|delete|shell>} for a gated built-in, {\"server\": <slug>} for an MCP tool, or null for a tool with no leasable scope (read-only built-ins, unknown names). The source decides, never a stray hook slug. The MCP server slug takes precedence over the built-in category and is compared RAW (no case folding). The runner's deriveLeaseScope and the server's deriveLeaseScope must agree.",
  "vectors": [
    {
      "name": "builtin-write-native",
      "input": { "toolName": "write_file" },
      "expected": { "category": "write" }
    },
    {
      "name": "builtin-write-cursor",
      "input": { "toolName": "Write" },
      "expected": { "category": "write" }
    },
    {
      "name": "builtin-edit-collapses-to-write",
      "input": { "toolName": "edit" },
      "expected": { "category": "write" }
    },
    {
      "name": "builtin-edit-cursor-collapses-to-write",
      "input": { "toolName": "StrReplace" },
      "expected": { "category": "write" }
    },
    {
      "name": "builtin-delete-native",
      "input": { "toolName": "delete_file" },
      "expected": { "category": "delete" }
    },
    {
      "name": "builtin-delete-cursor",
      "input": { "toolName": "Delete" },
      "expected": { "category": "delete" }
    },
    {
      "name": "builtin-shell-native",
      "input": { "toolName": "execute" },
      "expected": { "category": "shell" }
    },
    {
      "name": "builtin-shell-cursor",
      "input": { "toolName": "Shell" },
      "expected": { "category": "shell" }
    },
    {
      "name": "builtin-read-is-ungated",
      "input": { "toolName": "read" },
      "expected": null
    },
    {
      "name": "builtin-search-is-ungated",
      "input": { "toolName": "Grep" },
      "expected": null
    },
    {
      "name": "unknown-name-no-slug-is-ungated",
      "input": { "toolName": "process_return" },
      "expected": null
    },
    {
      "name": "mcp-tool-leases-its-server",
      "input": { "toolName": "create_issue", "mcpServerSlug": "github" },
      "expected": { "server": "github" }
    },
    {
      "name": "mcp-tool-other-server",
      "input": { "toolName": "list_resources", "mcpServerSlug": "planton" },
      "expected": { "server": "planton" }
    },
    {
      "name": "mcp-slug-is-not-case-folded",
      "input": { "toolName": "create_issue", "mcpServerSlug": "GitHub" },
      "expected": { "server": "GitHub" }
    },
    {
      "name": "mcp-slug-takes-precedence-over-builtin-name",
      "input": { "toolName": "write", "mcpServerSlug": "github" },
      "expected": { "server": "github" }
    },
    {
      "name": "hook-asked-builtin-leases-that-hook-on-that-tool",
      "input": { "toolName": "execute", "policySource": "APPROVAL_POLICY_SOURCE_HOOK", "policyHook": "safety" },
      "expected": { "hook": "safety", "tool": "execute", "server": "" }
    },
    {
      "name": "hook-asked-mcp-tool-keeps-its-server",
      "input": { "toolName": "create_issue", "mcpServerSlug": "github", "policySource": "APPROVAL_POLICY_SOURCE_HOOK", "policyHook": "safety" },
      "expected": { "hook": "safety", "tool": "create_issue", "server": "github" }
    },
    {
      "name": "agent-block-hook-has-an-empty-slug",
      "input": { "toolName": "write_file", "policySource": "APPROVAL_POLICY_SOURCE_HOOK", "policyHook": "" },
      "expected": { "hook": "", "tool": "write_file", "server": "" }
    },
    {
      "name": "hook-asked-read-only-builtin-still-leases",
      "input": { "toolName": "read_file", "policySource": "APPROVAL_POLICY_SOURCE_HOOK", "policyHook": "safety" },
      "expected": { "hook": "safety", "tool": "read_file", "server": "" }
    },
    {
      "name": "default-source-ignores-a-stray-hook",
      "input": { "toolName": "execute", "policySource": "APPROVAL_POLICY_SOURCE_BUILTIN_CATEGORY", "policyHook": "safety" },
      "expected": { "category": "shell" }
    }
  ]
}
