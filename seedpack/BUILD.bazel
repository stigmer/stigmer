load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "seedpack",
    srcs = [
        "embed.go",
        "seedpack.go",
    ],
    embedsrcs = [
        "stigmer.yaml",
    ] + glob([
        "skills/**",
        "agents/**",
        "mcp-servers/**",
    ]),
    importpath = "github.com/stigmer/stigmer/seedpack",
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_pkg_errors//:errors",
    ],
)

go_test(
    name = "seedpack_test",
    srcs = ["seedpack_test.go"],
    embed = [":seedpack"],
)
