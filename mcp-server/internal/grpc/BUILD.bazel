load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "grpc",
    srcs = ["client.go"],
    importpath = "github.com/stigmer/stigmer/mcp-server/internal/grpc",
    visibility = ["//mcp-server:__subpackages__"],
    deps = [
        "//mcp-server/internal/auth",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//credentials",
        "@org_golang_google_grpc//credentials/insecure",
    ],
)

go_test(
    name = "grpc_test",
    srcs = ["client_test.go"],
    embed = [":grpc"],
)
