load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "server",
    srcs = [
        "http.go",
        "server.go",
    ],
    importpath = "github.com/stigmer/stigmer/mcp-server/internal/server",
    visibility = ["//mcp-server:__subpackages__"],
    deps = [
        "//mcp-server/internal/auth",
        "//mcp-server/internal/config",
        "//mcp-server/internal/domains/agents",
        "//mcp-server/internal/domains/mcpservers",
        "//mcp-server/internal/domains/search",
        "//mcp-server/internal/domains/skills",
        "//mcp-server/internal/domains/workflowexecutions",
        "//mcp-server/internal/domains/workflows",
        "@com_github_modelcontextprotocol_go_sdk//auth",
        "@com_github_modelcontextprotocol_go_sdk//mcp",
        "@com_github_modelcontextprotocol_go_sdk//oauthex",
    ],
)

go_test(
    name = "server_test",
    srcs = ["http_test.go"],
    embed = [":server"],
    deps = [
        "//mcp-server/internal/auth",
        "//mcp-server/internal/config",
    ],
