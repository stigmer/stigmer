{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts"],
  "tsconfig": "tsconfig.typedoc.json",
  "skipErrorChecking": true,
  "json": "dist/api.json",
  "pretty": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "readme": "none",
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": true,
    "unusedMergeModuleWith": true
  },
  "requiredToBeDocumented": [
    "Variable",
    "Function",
    "Interface",
    "Property",
    "TypeAlias"
  ],
  "externalSymbolLinkMappings": {
    "@stigmer/sdk": {
      "Stigmer": "/docs/sdk",
      "DeploymentMode": "/docs/sdk/react/core"
    },
    "@stigmer/react": {
      "StigmerContext": "/docs/sdk/react/core",
      "DeploymentModeContext": "/docs/sdk/react/core",
      "useSessionConversation": "/docs/sdk/react/session",
      "useSessionUsage": "/docs/sdk/react/usage",
      "isTerminalPhase": "/docs/sdk/react/run",
      "formatCost": "/docs/sdk/react/usage",
      "formatTokenCount": "/docs/sdk/react/usage",
      "useContextWindow": "/docs/sdk/react/run",
      "useAgentSearch": "/docs/sdk/react/agent",
      "useSessionList": "/docs/sdk/react/session"
    },
    "@stigmer/protos": {
      "Run": "/docs/sdk/resources/run",
      "AgentMessage": "/docs/sdk/resources/run",
      "ToolCall": "/docs/sdk/resources/run",
      "PendingApproval": "/docs/sdk/resources/run",
      "SubAgentRun": "/docs/sdk/resources/run",
      "TodoItem": "/docs/sdk/resources/run",
      "RunPhase": "/docs/sdk/resources/run",
      "ToolCallStatus": "/docs/sdk/resources/run",
      "ApprovalAction": "/docs/sdk/resources/run",
      "MessageType": "/docs/sdk/resources/run",
      "SearchResult": "/docs/sdk/resources/search",
      "Session": "/docs/sdk/resources/session"
    }
  }
}
