<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>ai.stigmer</groupId>
    <artifactId>stigmer-java</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Stigmer Java SDK</name>
    <description>Java SDK client for the Stigmer platform</description>
    <url>https://github.com/stigmer/stigmer</url>

    <organization>
        <name>Stigmer</name>
        <url>https://stigmer.ai</url>
    </organization>

    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>stigmer</id>
            <name>Stigmer</name>
            <email>support@stigmer.ai</email>
            <organization>Stigmer</organization>
            <organizationUrl>https://stigmer.ai</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/stigmer/stigmer.git</connection>
        <developerConnection>scm:git:git@github.com:stigmer/stigmer.git</developerConnection>
        <url>https://github.com/stigmer/stigmer</url>
    </scm>

    <!--
      Snapshot deployment target for the dev-publishing channel (see
      .github/workflows/release.dev.yaml and .github/workflows/docs/dev-publishing.md).

      A `-SNAPSHOT` version deployed with plain `mvn deploy` (no `-P release`)
      goes here via the default maven-deploy-plugin. SNAPSHOTs are mutable and
      auto-expired by the Central Portal, so dev builds can be republished
      endlessly without polluting the immutable Maven Central release index.

      The `<id>central</id>` matches the server id configured by setup-java
      (and a developer's ~/.m2/settings.xml), so the same MAVEN_CENTRAL_*
      credentials authenticate both release and snapshot publishing.

      Releases continue to publish to Maven Central via the
      central-publishing-maven-plugin in the `release` profile below.
    -->
    <distributionManagement>
        <snapshotRepository>
            <id>central</id>
            <name>Central Portal Snapshots</name>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
        </snapshotRepository>
    </distributionManagement>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>

        <stigmer-protos.version>0.0.1-SNAPSHOT</stigmer-protos.version>
        <protobuf-java.version>4.34.0</protobuf-java.version>
        <grpc-java.version>1.79.0</grpc-java.version>
        <junit.version>5.11.4</junit.version>
    </properties>

    <dependencies>
        <!-- Generated protobuf and gRPC types for the Stigmer API -->
        <dependency>
            <groupId>ai.stigmer</groupId>
            <artifactId>stigmer-java-protos</artifactId>
            <version>${stigmer-protos.version}</version>
        </dependency>

        <!-- Protobuf runtime -->
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <version>${protobuf-java.version}</version>
        </dependency>

        <!-- gRPC client -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
            <version>${grpc-java.version}</version>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-protobuf</artifactId>
            <version>${grpc-java.version}</version>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-api</artifactId>
            <version>${grpc-java.version}</version>
        </dependency>

        <!-- Netty transport with TLS (shaded to avoid version conflicts) -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-netty-shaded</artifactId>
            <version>${grpc-java.version}</version>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>17</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.9.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <!--
                              Wait only until Sonatype validates the bundle, not until it
                              fully propagates to Maven Central. autoPublish still publishes
                              the deployment; "published" previously caused the job to poll
                              for ~25 min on every release even though the artifact published
                              successfully. Matches the apis/stubs/java protos pom.
                            -->
                            <waitUntil>validated</waitUntil>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.11.2</version>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
