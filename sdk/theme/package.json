{
  "name": "@stigmer/theme",
  "version": "0.0.0-dev",
  "description": "Design tokens, CSS custom properties, and utility functions for Stigmer UI components",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css",
    "./presets": "./src/presets/index.ts",
    "./presets/corporate.css": "./src/presets/corporate.css",
    "./presets/startup.css": "./src/presets/startup.css",
    "./presets/friendly.css": "./src/presets/friendly.css",
    "./presets/fintech.css": "./src/presets/fintech.css",
    "./presets/monochrome.css": "./src/presets/monochrome.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && cp src/tokens.css dist/tokens.css && mkdir -p dist/presets && cp src/presets/*.css dist/presets/",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "stigmer",
    "theme",
    "design-tokens",
    "tailwindcss",
    "css-variables"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./tokens.css": "./dist/tokens.css",
      "./presets": {
        "types": "./dist/presets/index.d.ts",
        "import": "./dist/presets/index.js"
      },
      "./presets/corporate.css": "./dist/presets/corporate.css",
      "./presets/startup.css": "./dist/presets/startup.css",
      "./presets/friendly.css": "./dist/presets/friendly.css",
      "./presets/fintech.css": "./dist/presets/fintech.css",
      "./presets/monochrome.css": "./dist/presets/monochrome.css"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stigmer/stigmer.git",
    "directory": "sdk/theme"
  },
  "peerDependencies": {
    "clsx": "^2.0.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
