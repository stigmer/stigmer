{
  "name": "@stigmer/react",
  "version": "0.0.0-dev",
  "description": "React provider and client hook for the Stigmer platform SDK",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./test": "./src/test/index.ts"
  },
  "scripts": {
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && tailwindcss -i src/styles.css -o dist/styles.css --minify",
    "build:css": "tailwindcss -i src/styles.css -o dist/styles.css --minify",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "vitest run -c vitest.a11y.config.ts",
    "typedoc:json": "typedoc",
    "tsdoc:coverage": "tsx scripts/tsdoc-coverage.ts",
    "tsdoc:check": "typedoc --treatValidationWarningsAsErrors"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "stigmer",
    "react",
    "sdk",
    "ai-agents"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./styles.css": "./dist/styles.css",
      "./test": {
        "types": "./dist/test/index.d.ts",
        "import": "./dist/test/index.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stigmer/stigmer.git",
    "directory": "sdk/react"
  },
  "dependencies": {
    "@bufbuild/protovalidate": "^1.1.1",
    "@dagrejs/dagre": "^1.1.4",
    "@stigmer/theme": "*",
    "diff": "^8.0.3",
    "fflate": "^0.8.2",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "highlight.js": "^11.11.1",
    "lowlight": "^3.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.0",
    "streamdown": "^2.5.0",
    "yaml": "^2.8.2"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.0.0",
    "@bufbuild/protobuf": "^2.8.0",
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/commands": "^6.0.0",
    "@codemirror/lang-yaml": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/lint": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@lezer/highlight": "^1.0.0",
    "@stigmer/protos": "*",
    "@stigmer/sdk": "*",
    "@tanstack/react-table": "^8.20.0",
    "@xyflow/react": "^12.0.0",
    "elkjs": "^0.9.0",
    "lucide-react": ">=0.400.0",
    "mermaid": "^11.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-virtuoso": "^4.0.0",
    "recharts": "^2.15.0"
  },
  "peerDependenciesMeta": {
    "@base-ui/react": {
      "optional": true
    },
    "@codemirror/autocomplete": {
      "optional": true
    },
    "@codemirror/commands": {
      "optional": true
    },
    "@codemirror/lang-yaml": {
      "optional": true
    },
    "@codemirror/language": {
      "optional": true
    },
    "@codemirror/lint": {
      "optional": true
    },
    "@codemirror/state": {
      "optional": true
    },
    "@codemirror/view": {
      "optional": true
    },
    "@lezer/highlight": {
      "optional": true
    },
    "@tanstack/react-table": {
      "optional": true
    },
    "@xyflow/react": {
      "optional": true
    },
    "elkjs": {
      "optional": true
    },
    "mermaid": {
      "optional": true
    },
    "react-virtuoso": {
      "optional": true
    },
    "recharts": {
      "optional": true
    }
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/language": "^6.10.8",
    "@codemirror/lint": "^6.8.5",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-table": "^8.21.3",
    "@testing-library/react": "^16.3.2",
    "@typescript-eslint/parser": "^8.57.0",
    "@vitest/browser": "^3.2.4",
    "@xyflow/react": "^12.10.2",
    "axe-core": "^4.11.4",
    "elkjs": "^0.9.3",
    "eslint": "^9.39.4",
    "happy-dom": "^20.8.4",
    "mermaid": "^11.15.0",
    "playwright": "^1.60.0",
    "postcss": "^8.5.15",
    "react-virtuoso": "^4.18.6",
    "recharts": "^2.15.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typedoc": "^0.28.18",
    "vitest": "^3.2.4"
  }
}
