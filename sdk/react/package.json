{
  "name": "@stigmer/react",
  "version": "0.0.0-dev",
  "description": "React provider and client hook for the Stigmer platform SDK",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./test": "./src/test/index.ts"
  },
  "scripts": {
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && tailwindcss -i src/styles.css -o dist/styles.css --minify",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest",
    "typedoc:json": "typedoc",
    "tsdoc:coverage": "tsx scripts/tsdoc-coverage.ts",
    "tsdoc:check": "typedoc --treatValidationWarningsAsErrors"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "stigmer",
    "react",
    "sdk",
    "ai-agents"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./styles.css": "./dist/styles.css",
      "./test": {
        "types": "./dist/test/index.d.ts",
        "import": "./dist/test/index.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stigmer/stigmer.git",
    "directory": "sdk/react"
  },
  "dependencies": {
    "@stigmer/theme": "*",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.8.2"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.0.0",
    "@bufbuild/protobuf": "^2.0.0",
    "@stigmer/protos": "*",
    "@stigmer/sdk": "*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@base-ui/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^9.39.4",
    "happy-dom": "^20.8.4",
    "tsx": "^4.21.0",
    "typedoc": "^0.28.18",
    "vitest": "^3.2.4"
  }
}
