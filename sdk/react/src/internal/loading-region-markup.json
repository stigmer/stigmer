    "sub",
    "sup",
    "time",
    "u",
    "var",
    "wbr"
  ],
  "elementsLeftToAxe": {
    "a": {
      "reason": "an a with an href is a link, which takes a name; the rule cannot see an href passed in a spread",
      "accepted": "<a id=\"probe\" href=\"#x\" aria-busy=\"true\" aria-label=\"Loading\"></a>"
    },
    "td": {
      "reason": "a table cell takes a name inside a table; axe cannot judge one alone",
      "accepted": "<table><tbody><tr><td id=\"probe\" aria-busy=\"true\" aria-label=\"Loading\"></td></tr></tbody></table>"
    },
    "th": {
      "reason": "a header cell takes a name inside a table; axe cannot judge one alone",
      "accepted": "<table><tbody><tr><th id=\"probe\" aria-busy=\"true\" aria-label=\"Loading\"></th></tr></tbody></table>"
    }
  },
