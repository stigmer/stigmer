{
  "name": "@stigmer/marketing",
  "version": "0.0.0",
  "private": true,
  "description": "Remotion workspace for Stigmer marketing films. Motion design + real product screen recordings; see README for the asset pipeline.",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts IntroToStigmer out/intro-to-stigmer.mp4",
    "narrate": "node scripts/narrate.mjs",
    "presenter": "node scripts/presenter.mjs",
    "demo:seed": "node films/intro/demo/seed.mjs",
    "demo:smoke": "node films/intro/demo/mcp/smoke.mjs",
    "demo:embed": "node films/intro/demo/embed/serve.mjs",
    "capture": "node films/intro/capture/capture.mjs",
    "capture:transcript": "node films/intro/capture/transcript.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@remotion/cli": "4.0.448",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.448",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "playwright": "^1.60.0",
    "typescript": "^5.7.0"
  }
}
