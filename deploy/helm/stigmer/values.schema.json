{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$comment": "The shape of values.yaml. additionalProperties is false at every level so a misspelled key fails `helm install` instead of silently doing nothing. Cross-field rules (a Secret is required; OIDC needs an audience; a disabled dependency needs its external address; an Enterprise setting needs a license) are template `fail`s in templates/_helpers.tpl, because they need sentences a schema cannot carry. The retired keys are declared here so a values file that still carries them installs, and their refusal when turned on names what replaced them.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "fullnameOverride": { "type": "string", "maxLength": 63 },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registry": { "type": "string", "minLength": 1 },
        "server": { "$ref": "#/$defs/serverImageRef" },
        "runner": { "$ref": "#/$defs/imageRef" },
        "pullPolicy": { "type": "string", "enum": ["IfNotPresent", "Always", "Never"] },
        "pullSecrets": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": { "type": "string" }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "publicUrl": { "$ref": "#/$defs/urlOrEmpty" },
        "artifactPublicUrl": { "$ref": "#/$defs/urlOrEmpty" },
        "allowUnauthenticatedExposure": { "type": "boolean" },
        "operator": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "email": { "type": "string" },
            "name": { "type": "string" }
          }
        },
        "oidc": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "issuer": { "$ref": "#/$defs/httpsUrlOrEmpty" },
            "audience": { "type": "string" },
            "consoleClientId": { "type": "string" }
          }
        },
        "resources": { "$ref": "#/$defs/resources" },
        "persistence": { "$ref": "#/$defs/persistence" },
        "securityContext": { "$ref": "#/$defs/containerSecurityContext" },
        "extraEnv": { "$ref": "#/$defs/envList" }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "llm": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "existingSecret": { "type": "string" } }
        },
        "stigmerToken": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": { "type": "string" },
            "key": { "type": "string", "minLength": 1 }
          }
        },
        "resources": { "$ref": "#/$defs/resources" },
        "persistence": { "$ref": "#/$defs/persistence" },
        "securityContext": { "$ref": "#/$defs/containerSecurityContext" },
        "extraEnv": { "$ref": "#/$defs/envList" }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "persistence": { "$ref": "#/$defs/persistence" } }
    },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 },
    "waitForDependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string", "minLength": 1 },
        "securityContext": { "$ref": "#/$defs/containerSecurityContext" }
      }
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string", "minLength": 1 },
        "persistence": { "$ref": "#/$defs/persistence" },
        "resources": { "$ref": "#/$defs/resources" },
        "securityContext": { "$ref": "#/$defs/containerSecurityContext" },
        "networkPolicy": { "$ref": "#/$defs/networkPolicy" }
      }
    },
    "externalDatabase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "user": { "type": "string", "minLength": 1 },
        "database": { "type": "string", "minLength": 1 },
        "existingSecret": { "type": "string" },
        "passwordKey": { "type": "string", "minLength": 1 }
      }
    },
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string", "minLength": 1 },
        "resources": { "$ref": "#/$defs/resources" },
        "securityContext": { "$ref": "#/$defs/containerSecurityContext" },
        "networkPolicy": { "$ref": "#/$defs/networkPolicy" }
      }
    },
    "externalTemporal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hostPort": { "type": "string" },
        "namespace": { "type": "string", "minLength": 1 },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "serverName": { "type": "string" },
            "existingSecret": { "type": "string" },
            "caKey": { "type": "string" },
            "certKey": { "type": "string" },
            "keyKey": { "type": "string" }
          }
        },
        "apiKey": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": { "type": "string" },
            "key": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "api": { "$ref": "#/$defs/ingressHost" },
        "artifacts": { "$ref": "#/$defs/ingressHost" }
      }
    },
    "enterprise": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "license": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": { "type": "string" },
            "key": { "type": "string", "minLength": 1 }
          }
        },
        "organizationCreators": {
          "$comment": "Account ids as the server reads them (ee/server/src/editions/organization-creators.ts): ida_ and 26 lowercase Crockford base32 characters.",
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^ida_[0-9a-hjkmnp-tv-z]{26}$" }
        },
        "accessHistoryRetentionDays": { "type": ["integer", "null"], "minimum": 1 },
        "outboundEgress": { "type": "string", "enum": ["strict", "relaxed"] }
      }
    },
    "egressPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "allowedCidrs": {
          "type": "array",
          "items": {
            "$comment": "An IPv4 or IPv6 CIDR: NetworkPolicy's ipBlock takes addresses, never host names.",
            "type": "string",
            "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$|^[0-9A-Fa-f:]*:[0-9A-Fa-f:]*/[0-9]{1,3}$"
          }
        }
      }
    },
    "openfga": { "$ref": "#/$defs/retiredUnit" },
    "redis": { "$ref": "#/$defs/retiredUnit" },
    "openbao": { "$ref": "#/$defs/retiredUnit" },
    "licenseKeySecret": {
      "type": "string",
      "description": "Retired: the license is enterprise.license.existingSecret. Kept so a values file that carries it empty still installs; set, it is refused naming the new value."
    }
  },
  "$defs": {
    "serverImageRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "enterpriseRepository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" }
      }
    },
    "imageRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" }
      }
    },
    "urlOrEmpty": {
      "type": "string",
      "pattern": "^$|^https?://"
    },
    "httpsUrlOrEmpty": {
      "$comment": "The OIDC issuer: discovery and the signing keys are fetched from it, so plaintext would let the network vouch for every token. The server also takes http on loopback for its tests; a chart issuer on loopback would name the pod, never the operator's identity provider.",
      "type": "string",
      "pattern": "^$|^https://"
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "containerSecurityContext": {
      "$comment": "A Kubernetes container SecurityContext (core/v1), every field it has and no other, so a typo fails like every other value.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowPrivilegeEscalation": { "type": "boolean" },
        "appArmorProfile": { "$ref": "#/$defs/securityProfile" },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "add": { "type": "array", "items": { "type": "string" } },
            "drop": { "type": "array", "items": { "type": "string" } }
          }
        },
        "privileged": { "type": "boolean" },
        "procMount": { "type": "string", "enum": ["Default", "Unmasked"] },
        "readOnlyRootFilesystem": { "type": "boolean" },
        "runAsGroup": { "type": "integer", "minimum": 0 },
        "runAsNonRoot": { "type": "boolean" },
        "runAsUser": { "type": "integer", "minimum": 0 },
        "seLinuxOptions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "level": { "type": "string" },
            "role": { "type": "string" },
            "type": { "type": "string" },
            "user": { "type": "string" }
          }
        },
        "seccompProfile": { "$ref": "#/$defs/securityProfile" },
        "windowsOptions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "gmsaCredentialSpec": { "type": "string" },
            "gmsaCredentialSpecName": { "type": "string" },
            "hostProcess": { "type": "boolean" },
            "runAsUserName": { "type": "string" }
          }
        }
      }
    },
    "securityProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["RuntimeDefault", "Localhost", "Unconfined"] },
        "localhostProfile": { "type": "string" }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": { "$ref": "#/$defs/quantities" },
        "limits": { "$ref": "#/$defs/quantities" }
      }
    },
    "quantities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": { "type": ["string", "number"] },
        "memory": { "type": "string" }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(Ei|Pi|Ti|Gi|Mi|Ki|E|P|T|G|M|K)?$" },
        "storageClass": { "type": "string" }
      }
    },
    "envList": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }
    },
    "ingressHost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": { "type": "string" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "tlsSecretName": { "type": "string" }
      }
    },
    "retiredUnit": {
      "type": "object",
      "additionalProperties": false,
      "description": "Retired: no Stigmer edition runs this beside the server. Kept so a values file that carries it at enabled: false still installs; turned on, it is refused with the reason.",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    }
  }
}
