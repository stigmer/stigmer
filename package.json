{
  "name": "stigmer",
  "private": true,
  "workspaces": [
    "apis/stubs/ts",
    "backend/libs/ts/temporal-codecs",
    "backend/libs/ts/zip-structure",
    "sdk/typescript",
    "sdk/theme",
    "sdk/react",
    "sdk/embed",
    "sdk/ink",
    "mcp-server",
    "seedpack",
    "demos",
    "client-apps/cli",
    "client-apps/web",
    "client-apps/desktop",
    "tools/codegen",
    "tools/eslint-plugin-stigmer",
    "marketing",
    "test/conformance",
    "test/e2e"
  ],
  "scripts": {
    "prepare": "husky || true",
    "build:runner-deps": "node scripts/turbo-set.mjs runner-deps build",
    "build:libs": "node scripts/turbo-set.mjs libs build",
    "clean:libs": "node scripts/turbo-set.mjs libs clean",
    "test": "node --test scripts/*.test.mjs && node scripts/turbo-set.mjs libs test"
  },
  "lint-staged": {
    "docs/**/*.{md,mdx}": [
      "prettier --write --prose-wrap always"
    ]
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "turbo": "2.10.12"
  },
  "overrides": {
    "zod": "^3.25.0",
    "@bufbuild/protobuf": "2.12.0"
  },
  "packageManager": "npm@10.9.4"
}
