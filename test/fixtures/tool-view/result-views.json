{
  "comment": "ToolCall projection -> expected ToolResultView. Only deterministic facts are asserted across languages (type, path, exitCode, count, mcpServerSlug). See test/fixtures/tool-view/README.md.",
  "cases": [
    {
      "name": "native_edit_success",
      "harness": "native",
      "toolName": "edit_file",
      "mcpServerSlug": "",
      "args": { "file_path": "/workspace/x.md", "old_string": "Hello", "new_string": "Hello world\nNew line" },
      "result": "Successfully replaced 1 occurrence in '/workspace/x.md'",
      "expected": { "type": "diff", "path": "/workspace/x.md" }
    },
    {
      "name": "native_write_confirmation",
      "harness": "native",
      "toolName": "write_file",
      "mcpServerSlug": "",
      "args": { "file_path": "/workspace/new.txt", "contents": "alpha\nbeta\n" },
      "result": "Successfully wrote to '/workspace/new.txt'",
      "expected": { "type": "file", "path": "/workspace/new.txt" }
    },
    {
      "name": "native_read",
      "harness": "native",
      "toolName": "read_file",
      "mcpServerSlug": "",
      "args": { "file_path": "/workspace/main.go" },
      "result": "     1\tpackage main\n     2\t",
      "expected": { "type": "file", "path": "/workspace/main.go" }
    },
    {
      "name": "native_read_framed",
      "harness": "native",
      "toolName": "read_file",
      "mcpServerSlug": "",
      "args": { "file_path": "/workspace/main.go" },
      "result": "@@ lines 1-2 of 2 @@\npackage main\n",
      "expected": { "type": "file", "path": "/workspace/main.go" }
    },
    {
      "name": "native_shell_success",
      "harness": "native",
      "toolName": "execute",
      "mcpServerSlug": "",
      "args": { "command": "ls -la" },
      "result": "total 8\ndrwxr-xr-x  2 user user 4096 .\n[Command succeeded]",
      "expected": { "type": "terminal", "exitCode": 0, "command": "ls -la" }
    },
    {
      "name": "native_shell_failure",
      "harness": "native",
      "toolName": "execute",
      "mcpServerSlug": "",
      "args": { "command": "false" },
      "result": "some stderr output\n[Command failed with exit code 1]",
      "expected": { "type": "terminal", "exitCode": 1, "command": "false" }
    },
    {
      "name": "native_grep_matches",
      "harness": "native",
      "toolName": "grep",
      "mcpServerSlug": "",
      "args": { "pattern": "TODO" },
      "result": "\n/workspace/a.go:\n  12: // TODO: fix\n/workspace/b.go:\n  7: // TODO: later",
      "expected": { "type": "search", "count": 2 }
    },
    {
      "name": "native_ls_entries",
      "harness": "native",
      "toolName": "ls",
      "mcpServerSlug": "",
      "args": { "path": "/workspace" },
      "result": "a.go\nb.go\nREADME.md",
      "expected": { "type": "list", "count": 3 }
    },
    {
      "name": "mcp_content_blocks",
      "harness": "native",
      "toolName": "search_services",
      "mcpServerSlug": "planton",
      "args": { "query": "billing" },
      "result": "{\"content\":[{\"type\":\"text\",\"text\":\"two services found\"}]}",
      "expected": { "type": "contentBlocks", "mcpServerSlug": "planton" }
    },
    {
      "name": "think_text",
      "harness": "native",
      "toolName": "think",
      "mcpServerSlug": "",
      "args": { "thought": "I should read the config first." },
      "result": "ok",
      "expected": { "type": "text" }
    },
    {
      "name": "unknown_json_object",
      "harness": "native",
      "toolName": "some_json_tool",
      "mcpServerSlug": "",
      "args": {},
      "result": "{\"diagnostics\":[],\"count\":0}",
      "expected": { "type": "json" }
    },
    {
      "name": "unknown_plain_text",
      "harness": "native",
      "toolName": "some_unknown_tool",
      "mcpServerSlug": "",
      "args": {},
      "result": "just some text",
      "expected": { "type": "text" }
    },
    {
      "name": "failed_tool_error",
      "harness": "native",
      "toolName": "execute",
      "mcpServerSlug": "",
      "args": { "command": "boom" },
      "result": "",
      "error": "command not found: boom",
      "status": "TOOL_CALL_FAILED",
      "expected": { "type": "error" }
    },
    {
      "name": "remember_proposal_plain",
      "harness": "native",
      "toolName": "remember",
      "mcpServerSlug": "stigmer-memory",
      "args": { "fact": "Prefers concise answers with code examples." },
      "result": "{\"outcome\":\"Proposed — the user decides. Nothing is remembered unless they confirm this fact.\",\"memory\":{\"api_version\":\"agentic.stigmer.ai/v1\",\"kind\":\"Memory\",\"metadata\":{\"id\":\"mem_01test\",\"org\":\"acme\"},\"spec\":{\"content\":\"Prefers concise answers with code examples.\",\"subject_identity_account_id\":\"ida_subject\"},\"status\":{\"lifecycle_state\":\"lifecycle_state_proposed\"}}}",
      "expected": { "type": "memoryProposal", "memoryId": "mem_01test", "fact": "Prefers concise answers with code examples." }
    },
    {
      "name": "remember_proposal_content_blocks",
      "harness": "native",
      "toolName": "remember",
      "mcpServerSlug": "stigmer-memory",
      "args": { "fact": "Works primarily in Go." },
      "result": "{\"content\":[{\"type\":\"text\",\"text\":\"{\\\"outcome\\\":\\\"Proposed — the user decides. Nothing is remembered unless they confirm this fact.\\\",\\\"memory\\\":{\\\"metadata\\\":{\\\"id\\\":\\\"mem_02test\\\"},\\\"spec\\\":{\\\"content\\\":\\\"Works primarily in Go.\\\"}}}\"}]}",
      "expected": { "type": "memoryProposal", "memoryId": "mem_02test", "fact": "Works primarily in Go." }
    },
    {
      "name": "remember_unrecognized_payload_degrades",
      "harness": "native",
      "toolName": "remember",
      "mcpServerSlug": "stigmer-memory",
      "args": { "fact": "Any fact." },
      "result": "unexpected plain text",
      "expected": { "type": "text" }
    },
    {
      "name": "claude_shell_success",
      "harness": "claude",
      "toolName": "Bash",
      "mcpServerSlug": "",
      "args": { "command": "printf 'one\\ntwo\\n'", "description": "Print two lines" },
      "result": "one\ntwo\n",
      "expected": { "type": "terminal", "exitCode": 0, "command": "printf 'one\\ntwo\\n'" }
    },
    {
      "name": "claude_shell_failure",
      "harness": "claude",
      "toolName": "Bash",
      "mcpServerSlug": "",
      "args": { "command": "echo broken >&2; exit 3", "description": "Fail on purpose" },
      "result": "broken\n",
      "error": "[stderr] broken\n\nExit code: 3",
      "status": "TOOL_CALL_FAILED",
      "expected": { "type": "error" }
    },
    {
      "name": "claude_write",
      "harness": "claude",
      "toolName": "Write",
      "mcpServerSlug": "",
      "args": { "file_path": "/workspace/notes.md", "content": "# Notes\n\nfirst\n" },
      "result": "File created successfully at: /workspace/notes.md (file state is current in your context — no need to Read it back)",
      "expected": { "type": "file", "path": "/workspace/notes.md" }
    },
    {
      "name": "claude_read_numbered_lines",
      "harness": "claude",
      "toolName": "Read",
      "mcpServerSlug": "",
      "args": { "file_path": "/workspace/notes.md" },
      "result": "1\t# Notes\n2\t\n3\tfirst\n4\t",
      "expected": { "type": "file", "path": "/workspace/notes.md" }
    },
    {
      "name": "claude_edit",
      "harness": "claude",
      "toolName": "Edit",
      "mcpServerSlug": "",
      "args": { "file_path": "/workspace/notes.md", "old_string": "first\n", "new_string": "first\nsecond\n" },
      "result": "The file /workspace/notes.md has been updated successfully. (file state is current in your context — no need to Read it back)",
      "expected": { "type": "diff", "path": "/workspace/notes.md" }
    },
    {
      "name": "claude_glob",
      "harness": "claude",
      "toolName": "Glob",
      "mcpServerSlug": "",
      "args": { "pattern": "*.md" },
      "result": "notes.md",
      "expected": { "type": "search", "count": 1 }
    },
    {
      "name": "claude_grep",
      "harness": "claude",
      "toolName": "Grep",
      "mcpServerSlug": "",
      "args": { "pattern": "second", "output_mode": "content" },
      "result": "notes.md:4:second",
      "expected": { "type": "search", "count": 1 }
    },
    {
      "name": "claude_todo_write",
      "harness": "claude",
      "toolName": "TodoWrite",
      "mcpServerSlug": "",
      "args": { "todos": [{ "content": "Read the fixture", "status": "pending", "activeForm": "Reading the fixture" }, { "content": "Summarise it", "status": "in_progress", "activeForm": "Summarising it" }] },
      "result": "Todos have been modified successfully. Ensure that you continue to use the todo list to track your progress. Please proceed with the current tasks if applicable",
      "expected": { "type": "text" }
    },
    {
      "name": "claude_skill",
      "harness": "claude",
      "toolName": "Skill",
      "mcpServerSlug": "",
      "args": { "skill": "acme:lint" },
      "result": "Launching skill: acme:lint",
      "expected": { "type": "text" }
    },
    {
      "name": "claude_agent",
      "harness": "claude",
      "toolName": "Agent",
      "mcpServerSlug": "",
      "args": { "description": "run the tests", "prompt": "Run the tests and report.", "subagent_type": "test-runner" },
      "result": "All suites pass.",
      "expected": { "type": "text" }
    },
    {
      "name": "claude_remember_proposal",
      "harness": "claude",
      "toolName": "remember",
      "mcpServerSlug": "stigmer-memory",
      "args": { "fact": "The thing is found." },
      "result": "{\"outcome\":\"Proposed — the user decides. Nothing is remembered unless they confirm this fact.\",\"memory\":{\"metadata\":{\"id\":\"mem_claude_1\",\"org\":\"hermetic-org\"},\"spec\":{\"content\":\"The thing is found.\"},\"status\":{\"lifecycle_state\":\"lifecycle_state_proposed\"}}}",
      "expected": { "type": "memoryProposal", "memoryId": "mem_claude_1", "fact": "The thing is found." }
    }
  ]
}
