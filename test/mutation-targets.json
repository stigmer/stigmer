{
  "targets": {
    "server-authorization": {
      "title": "the server's authorization decisions",
      "package": "backend/services/stigmer-server",
      "mutate": [
        "src/authorization/**/*.ts",
        "!src/**/__tests__/**",
        "!src/**/*.test.ts"
      ],
      "concurrency": 4
    },
    "server-iam-policy": {
      "title": "the server's grant rules",
      "package": "backend/services/stigmer-server",
      "mutate": [
        "src/domain/grant/roles.ts",
        "src/domain/grant/permissions.ts",
        "src/domain/grant/grant-path.ts",
        "src/domain/grant/grant-scope.ts",
        "src/domain/grant/membership.ts",
        "src/domain/grant/role-lifecycle.ts",
        "src/domain/grant/access-lists.ts",
        "!src/**/__tests__/**",
        "!src/**/*.test.ts"
      ],
      "concurrency": 4
    },
    "server-request-checks": {
      "title": "the server's request checks",
      "package": "backend/services/stigmer-server",
      "mutate": [
        "src/pipeline/steps/validation.ts",
        "src/pipeline/steps/slug.ts",
        "src/pipeline/steps/duplicate.ts",
        "src/pipeline/steps/validate-visibility.ts",
        "src/pipeline/steps/guard-*.ts",
        "src/pipeline/steps/authorize*.ts",
        "!src/**/__tests__/**",
        "!src/**/*.test.ts"
      ],
      "concurrency": 4
    },
    "server-schedules-secrets-archives": {
      "title": "the server's schedules, secrets at rest and archive limits",
      "package": "backend/services/stigmer-server",
      "mutate": [
        "src/domain/routine/cron.ts",
        "src/domain/routine/clock.ts",
        "src/domain/routine/fire.ts",
        "src/encryption/codec.ts",
        "src/encryption/v1-codec.ts",
        "src/encryption/scope.ts",
        "src/platformtoken/envelope.ts",
        "src/platformtoken/key-ring.ts",
        "src/archive/limits.ts",
        "src/archive/inflate.ts",
        "src/archive/prefilter.ts",
        "!src/**/__tests__/**",
        "!src/**/*.test.ts"
      ],
      "concurrency": 4
    },
    "ee-provider-validation": {
      "title": "Stigmer Enterprise's federation issuer validation",
      "package": "ee/server",
      "mutate": [
        "src/iam/issuer/validation.ts",
        "!src/**/__tests__/**",
        "!src/**/*.test.ts"
      ],
      "concurrency": 4
    },
    "ee-federation-verifier": {
      "title": "Stigmer Enterprise's federated token verification",
      "package": "ee/server",
      "mutate": [
        "src/iam/federation/verifier.ts",
        "!src/**/__tests__/**",
        "!src/**/*.test.ts"
      ],
      "concurrency": 4
    },
    "runner-middleware-pricing-guards": {
      "title": "the runner's middleware, pricing and guards",
      "package": "backend/services/runner",
      "mutate": [
        "src/middleware/approval-gate.ts",
        "src/middleware/loop-detection.ts",
        "src/middleware/execution-budget.ts",
        "src/middleware/tool-truncation.ts",
        "src/middleware/path-normalization.ts",
        "src/shared/model-pricing.ts",
        "src/shared/cost-guard.ts",
        "src/tools/url-guard.ts",
        "!src/**/__tests__/**",
        "!src/**/*.test.ts"
      ],
      "concurrency": 4
    }
  }
}
