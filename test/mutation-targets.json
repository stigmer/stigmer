{
  "targets": {
    "server-authorization": {
      "title": "the server's authorization decisions",
      "package": "backend/services/stigmer-server",
      "mutate": [
        "src/authorization/**/*.ts",
        "!src/**/__tests__/**",
        "!src/**/*.test.ts"
      ],
      "concurrency": 4
    },
    "server-iam-policy": {
      "title": "the server's grant rules",
      "package": "backend/services/stigmer-server",
      "mutate": [
        "src/domain/grant/roles.ts",
        "src/domain/grant/permissions.ts",
        "src/domain/grant/grant-path.ts",
        "src/domain/grant/grant-scope.ts",
        "src/domain/grant/membership.ts",
        "src/domain/grant/role-lifecycle.ts",
        "src/domain/grant/access-lists.ts",
        "!src/**/__tests__/**",
        "!src/**/*.test.ts"
      ],
      "concurrency": 4
    },
    "server-request-checks": {
      "title": "the server's request checks",
      "package": "backend/services/stigmer-server",
      "mutate": [
        "src/pipeline/steps/validation.ts",
        "src/pipeline/steps/slug.ts",
        "src/pipeline/steps/duplicate.ts",
        "src/pipeline/steps/validate-visibility.ts",
        "src/pipeline/steps/guard-*.ts",
        "src/pipeline/steps/authorize*.ts",
        "src/domain/run/require-model-provider.ts",
        "src/modelcatalog/provider-need.ts",
        "src/extensions/provider-availability.ts",
        "!src/**/__tests__/**",
        "!src/**/*.test.ts"
      ],
      "concurrency": 4
    },
    "server-schedules-secrets-archives": {
      "title": "the server's schedules, secrets at rest and archive limits",
      "package": "backend/services/stigmer-server",
      "mutate": [
        "src/domain/routine/cron.ts",
        "src/domain/routine/clock.ts",
        "src/domain/routine/fire.ts",
        "src/encryption/codec.ts",
        "src/encryption/v1-codec.ts",
        "src/encryption/scope.ts",
        "src/platformtoken/envelope.ts",
        "src/platformtoken/key-ring.ts",
        "src/archive/limits.ts",
        "src/archive/inflate.ts",
        "src/archive/prefilter.ts",
        "!src/**/__tests__/**",
        "!src/**/*.test.ts"
      ],
      "concurrency": 4
    },
    "ee-provider-validation": {
      "title": "Stigmer Enterprise's federation issuer validation",
      "package": "ee/server",
      "mutate": [
        "src/iam/issuer/validation.ts",
        "!src/**/__tests__/**",
        "!src/**/*.test.ts"
      ],
      "concurrency": 4
    },
    "ee-federation-verifier": {
      "title": "Stigmer Enterprise's federated token verification",
      "package": "ee/server",
      "mutate": [
        "src/iam/federation/verifier.ts",
        "!src/**/__tests__/**",
        "!src/**/*.test.ts"
      ],
      "concurrency": 4
    },
    "runner-middleware-pricing-guards": {
      "title": "the runner's middleware, pricing and guards",
      "package": "backend/services/runner",
      "mutate": [
        "src/middleware/approval-gate.ts",
        "src/middleware/loop-detection.ts",
        "src/middleware/execution-budget.ts",
        "src/middleware/tool-truncation.ts",
        "src/middleware/path-normalization.ts",
        "src/shared/model-pricing.ts",
        "src/shared/cost-guard.ts",
        "src/tools/url-guard.ts",
        "!src/**/__tests__/**",
        "!src/**/*.test.ts"
      ],
      "concurrency": 4
    },
    "cli-output": {
      "title": "the CLI's output, errors and run rendering",
      "package": "client-apps/cli",
      "mutate": [
        "src/output/*.ts",
        "src/errors/*.ts",
        "src/resources/render.ts",
        "src/resources/stream/*.ts",
        "src/resources/run/epilogue.ts",
        "!src/**/__tests__/**",
        "!src/**/*.test.ts"
      ],
      "concurrency": 4
    },
    "cli-provider-reach": {
      "title": "which model providers the laptop's runner reaches",
      "package": "client-apps/cli",
      "mutate": [
        "src/local/provider-reach.ts"
      ],
      "concurrency": 4
    },
    "client-turn-activity": {
      "title": "what a working turn is doing, for how long and how far",
      "package": "sdk/typescript",
      "mutate": [
        "src/run/turn-activity.ts"
      ],
      "concurrency": 4
    },
    "client-exit-codes": {
      "title": "the exit code a turn's outcome or an error gives a command-line tool",
      "package": "sdk/typescript",
      "mutate": [
        "src/exit-codes.ts"
      ],
      "concurrency": 4
    },
    "client-token-cache": {
      "title": "a signed-in embed's token, fetched once until it nears expiry",
      "package": "sdk/typescript",
      "mutate": [
        "src/internal/expiring-token.ts",
        "src/token-cache.ts"
      ],
      "concurrency": 4
    },
    "react-agent-chat": {
      "title": "the chat's frames: which conversation shows, and what the closed popup says",
      "package": "sdk/react",
      "mutate": [
        "src/agent-chat/agent-chat-state.ts",
        "src/agent-chat/chat-activity-of.ts"
      ],
      "concurrency": 4
    },
    "react-session-outcome": {
      "title": "what closes a turn: its Files, changes, time and cost",
      "package": "sdk/react",
      "mutate": [
        "src/session/turn-outcome.ts"
      ],
      "concurrency": 4
    },
    "react-model-readiness": {
      "title": "the React kit's reading of which models can run",
      "package": "sdk/react",
      "mutate": [
        "src/models/useModelReadiness.ts",
        "src/models/readiness.ts"
      ],
      "concurrency": 4
    },
    "ink-logic": {
      "title": "the terminal kit's file review, markdown, run API, failure wording, terminal mode and command line",
      "package": "sdk/ink",
      "mutate": [
        "src/file-review.ts",
        "src/markdown.ts",
        "src/run/run-in-terminal.tsx",
        "src/errors.ts",
        "src/terminal-mode.ts",
        "src/cli/args.ts",
        "!src/**/__tests__/**",
        "!src/**/*.test.ts"
      ],
      "concurrency": 4
    }
  }
}
