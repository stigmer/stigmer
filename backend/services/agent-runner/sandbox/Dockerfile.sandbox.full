# Cloud Sandbox with Agent Runner
# Daytona sandbox image for cloud-mode agent execution. Published to GHCR.
#
# Build context: Repository root
# Build command: docker build -f backend/services/agent-runner/sandbox/Dockerfile.sandbox.full .
#
# This image provides:
#   1. MCP server runtimes: npx (Node.js), uvx (Python), go run (Go)
#   2. Pre-installed seedpack MCP server packages (npm, pip, go)
#   3. Agent-runner Python worker (virtualenv + source + dependencies)
#   4. Core utilities: git, curl, jq, yq, yamllint
#
# Cloud CLIs (aws, gcloud, az, kubectl, terraform, pulumi, helm, etc.) are
# NOT included. Agents that need them can install on-demand.
#
# The agent-runner is baked in per DD01 (unified sandbox image). Daytona
# creates sandboxes directly from this image via CreateSandboxFromImageParams.
# The CI pipeline warms Daytona's image cache after each push for sub-second
# sandbox creation. The runner process is started by stigmer-service via
# sandbox.process.exec() after sandbox creation — CMD stays /bin/bash
# per Daytona convention.
#
# The standalone Dockerfile (backend/services/agent-runner/Dockerfile)
# remains for K8s pod deployment, local/OSS mode, and CI testing.
#
# Platform: linux/amd64 only (Go toolchain COPY is architecture-specific)

# ---------- Agent Runner Builder ----------
# Builds the Python virtualenv with all runner dependencies.
# Uses debian:bookworm-slim (same as the sandbox runtime stage) so that
# virtualenv symlinks target /usr/bin/python3 and pyvenv.cfg paths are
# valid in the final image without any post-copy fixups.
FROM debian:bookworm-slim AS runner-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    git \
    curl \
    ca-certificates \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Match repository structure so Poetry's editable (path) dependencies resolve
WORKDIR /app/backend/services/agent-runner

ARG POETRY_VERSION=2.1.2
RUN curl -fsSL https://install.python-poetry.org | POETRY_VERSION=${POETRY_VERSION} python3 - && \
    mv /root/.local/bin/poetry /usr/local/bin/poetry

# Copy dependency files first for optimal layer caching
COPY backend/services/agent-runner/pyproject.toml backend/services/agent-runner/poetry.lock* ./

# Copy local path dependencies referenced in pyproject.toml
COPY backend/libs/python/graphton /app/backend/libs/python/graphton
COPY apis/stubs/python /app/apis/stubs/python

# Install dependencies into in-project virtualenv
ENV POETRY_VIRTUALENVS_IN_PROJECT=true
RUN poetry config virtualenvs.in-project true && \
    poetry install --only main --no-interaction --no-ansi --no-root

# WORKAROUND: deepagents-cli (0.0.3) ships files in the `deepagents/` namespace that
# overwrite clean files from the `deepagents` package during installation. This is an
# upstream packaging defect — both packages write to the same directory, and the CLI
# package's copies are corrupted/truncated. Reinstalling `deepagents` after Poetry
# restores the correct files. The verification step below will catch any regression.
RUN .venv/bin/pip install --force-reinstall --no-deps deepagents==0.4.0

# Verify deepagents is importable (catches corrupted PyPI packages at build time)
RUN .venv/bin/python -c "\
from deepagents.middleware.subagents import SubAgentMiddleware; \
from deepagents.middleware.filesystem import FilesystemMiddleware; \
from deepagents import create_deep_agent; \
print('deepagents import verification passed')"

# Verify all LangGraph checkpointer backends are importable.
# langgraph-checkpoint-mongodb and langgraph-checkpoint-sqlite are separate
# pip packages that share the langgraph.checkpoint namespace. If a version
# upgrade breaks namespace package resolution, this gate catches it at build
# time instead of causing a runtime crash loop in production.
RUN .venv/bin/python -c "\
from langgraph.checkpoint.memory import MemorySaver; \
from langgraph.checkpoint.sqlite.aio import AsyncSqliteSaver; \
from langgraph.checkpoint.mongodb import MongoDBSaver; \
print('checkpointer import verification passed')"

# ---------- Sandbox Image ----------
FROM debian:bookworm-slim

# Install base utilities and MCP server runtimes
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    git \
    ca-certificates \
    jq \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Install Python3, pip, Node.js, and npm (MCP server runtimes: npx, uvx)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    nodejs \
    npm \
    yamllint \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/*

# Install PyYAML globally
RUN pip3 install --no-cache-dir pyyaml --break-system-packages

# Go toolchain (for 'go run' of Go-based MCP servers)
COPY --from=public.ecr.aws/docker/library/golang:1.25 /usr/local/go /usr/local/go
ENV PATH="/usr/local/go/bin:${PATH}"
ENV GOPATH="/root/go"
ENV PATH="${GOPATH}/bin:${PATH}"

# uv / uvx (Python package runner — the PyPI equivalent of npx)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

# Install yq (YAML processor)
RUN YQ_VERSION=v4.40.5 && \
    wget -qO /usr/local/bin/yq https://github.com/mikefarah/yq/releases/download/${YQ_VERSION}/yq_linux_amd64 && \
    chmod +x /usr/local/bin/yq

# ---------- Pre-installed MCP Server Packages ----------
# Seedpack stdio MCP servers baked in so first-run latency is zero.
# Each package is installed individually; a single failure does not block
# the rest. Packages not in this list install on-demand via npx/uvx/go run.

# npm: globally installed so npx resolves them without downloading.
# Installed individually so a single 404 does not block the rest.
RUN for pkg in \
      @modelcontextprotocol/server-memory \
      @modelcontextprotocol/server-filesystem \
      @modelcontextprotocol/server-git \
      @modelcontextprotocol/server-sequential-thinking \
      @brave/brave-search-mcp-server \
      @strowk/mcp-k8s \
      @benborla29/mcp-server-mysql \
      @cocal/google-calendar-mcp \
      @twilio-alpha/mcp \
      exa-mcp-server \
      mcp-sqlite \
      mongodb-mcp-server \
      resend-mcp; \
    do npm install -g "$pkg" || echo "WARN: failed to install $pkg"; done && \
    npm cache clean --force

# pip: installed via uv tool so uvx resolves them from cache
RUN uv tool install mcp-server-fetch && \
    uv tool install redis-mcp-server && \
    uv tool install postgres-mcp && \
    uv tool install awslabs.lambda-tool-mcp-server && \
    uv tool install awslabs.aws-documentation-mcp-server && \
    uv tool install awslabs.cdk-mcp-server && \
    uv cache clean

# go: go run downloads and caches modules on first invocation.
# Pre-compilation via go install is not possible for modules with replace
# directives (e.g. terraform-mcp-server). The first go run incurs a ~5s
# compile cost; subsequent runs use the build cache inside the sandbox.

# ---------- Agent Runner ----------
# Baked in per DD01: the runner IS the sandbox. stigmer-service starts the
# worker process via sandbox.process.exec() after sandbox creation.
COPY backend/services/agent-runner/ /app/
COPY backend/libs/python/graphton /app/backend/libs/python/graphton
COPY apis/stubs/python /app/apis/stubs/python
COPY --from=runner-builder /app/backend/services/agent-runner/.venv /app/.venv

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Verify runner dependencies are importable in the final image.
# Uses cd /app so that worker.* resolves on sys.path (WORKDIR is /workspace).
RUN cd /app && /app/.venv/bin/python -c "\
from worker.config import Config; \
from deepagents.middleware.subagents import SubAgentMiddleware; \
print('agent-runner import verification passed')"

# Set working directory (Daytona convention — user workspace, not runner code)
WORKDIR /workspace

# Verify MCP runtimes and core utilities
RUN git --version && \
    python3 --version && \
    python --version && \
    pip3 --version && \
    node --version && \
    npm --version && \
    go version && \
    uv --version && \
    uvx --version && \
    jq --version && \
    yq --version && \
    yamllint --version && \
    /app/.venv/bin/python --version

CMD ["/bin/bash"]
