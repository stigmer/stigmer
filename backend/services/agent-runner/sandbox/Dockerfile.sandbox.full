# Cloud Sandbox with Agent Runner + Cursor Runner
# Daytona sandbox image for cloud-mode agent execution. Published to GHCR.
#
# Build context: Repository root
# Build command: docker build -f backend/services/agent-runner/sandbox/Dockerfile.sandbox.full .
#
# This image provides:
#   1. MCP server runtimes: npx (Node.js 22 LTS), uvx (Python), go run (Go)
#   2. Agent-runner Python worker (virtualenv + source + dependencies)
#   3. Cursor-runner TypeScript worker (compiled JS + node_modules)
#   4. Core utilities: git, curl, jq, yq, yamllint
#
# MCP server packages (npm, pip, go modules) are NOT baked into the image.
# They are installed on-demand by the agent-runner during execution setup,
# derived from the merged (agent + session) MCP server specs. This keeps
# the image slim and agent-specific.
#
# Cloud CLIs (aws, gcloud, az, kubectl, terraform, pulumi, helm, etc.) are
# NOT included. Agents that need them can install on-demand.
#
# Both runners are baked in per DD01 (unified sandbox image). Daytona
# creates sandboxes directly from this image via CreateSandboxFromImageParams.
# The CI pipeline warms Daytona's image cache after each push for sub-second
# sandbox creation. Runner processes are started by stigmer-service via
# sandbox.process.exec() after sandbox creation — CMD stays /bin/bash
# per Daytona convention.
#
# The standalone Dockerfile (backend/services/agent-runner/Dockerfile)
# remains for K8s pod deployment, local/OSS mode, and CI testing.
#
# Platform: linux/amd64 only (Go toolchain COPY is architecture-specific)

# ---------- Agent Runner Builder ----------
# Builds the Python virtualenv with all runner dependencies.
# Uses debian:bookworm-slim (same as the sandbox runtime stage) so that
# virtualenv symlinks target /usr/bin/python3 and pyvenv.cfg paths are
# valid in the final image without any post-copy fixups.
FROM debian:bookworm-slim AS runner-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    git \
    curl \
    ca-certificates \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/backend/services/agent-runner

# Create virtualenv
RUN python3 -m venv .venv

# Copy pinned requirements (auto-generated from poetry.lock, excludes path deps)
COPY backend/services/agent-runner/requirements.txt ./

# Install PyPI dependencies from pinned list
RUN .venv/bin/pip install --no-cache-dir -r requirements.txt

# Install local path dependencies
COPY backend/libs/python/graphton /app/backend/libs/python/graphton
COPY apis/stubs/python /app/apis/stubs/python
RUN .venv/bin/pip install --no-cache-dir /app/backend/libs/python/graphton
RUN .venv/bin/pip install --no-cache-dir /app/apis/stubs/python/stigmer

# WORKAROUND: deepagents-cli (0.0.3) ships files in the `deepagents/` namespace that
# overwrite clean files from the `deepagents` package during installation. This is an
# upstream packaging defect — both packages write to the same directory, and the CLI
# package's copies are corrupted/truncated. Reinstalling `deepagents` after pip
# restores the correct files. The verification step below will catch any regression.
RUN .venv/bin/pip install --force-reinstall --no-deps deepagents==0.4.0

# Verify deepagents is importable (catches corrupted PyPI packages at build time)
RUN .venv/bin/python -c "\
from deepagents.middleware.subagents import SubAgentMiddleware; \
from deepagents.middleware.filesystem import FilesystemMiddleware; \
from deepagents import create_deep_agent; \
print('deepagents import verification passed')"

# Verify all LangGraph checkpointer backends are importable.
# langgraph-checkpoint-mongodb and langgraph-checkpoint-sqlite are separate
# pip packages that share the langgraph.checkpoint namespace. If a version
# upgrade breaks namespace package resolution, this gate catches it at build
# time instead of causing a runtime crash loop in production.
RUN .venv/bin/python -c "\
from langgraph.checkpoint.memory import MemorySaver; \
from langgraph.checkpoint.sqlite.aio import AsyncSqliteSaver; \
from langgraph.checkpoint.mongodb import MongoDBSaver; \
print('checkpointer import verification passed')"

# ---------- Cursor Runner Builder ----------
# Compiles TypeScript to JavaScript and installs production npm dependencies.
# Uses the official Node.js 22 image (matches the runtime in the final stage).
FROM public.ecr.aws/docker/library/node:22-slim AS cursor-runner-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy proto stubs (local file: dependency)
COPY apis/stubs/ts /build/apis/stubs/ts
RUN cd /build/apis/stubs/ts && npm install

# Copy cursor-runner source and install deps
COPY backend/services/cursor-runner/package.json \
     backend/services/cursor-runner/tsconfig.json \
     backend/services/cursor-runner/tsconfig.build.json \
     /build/cursor-runner/

# Rewrite the file: proto dep to point to /build/apis/stubs/ts
RUN cd /build/cursor-runner && \
    node -e "const p=require('./package.json'); \
    p.dependencies['@stigmer/protos']='file:/build/apis/stubs/ts'; \
    require('fs').writeFileSync('package.json',JSON.stringify(p,null,2)+'\n')"

RUN cd /build/cursor-runner && npm install

COPY backend/services/cursor-runner/src /build/cursor-runner/src
COPY backend/services/cursor-runner/data/model-registry.json /build/cursor-runner/data/model-registry.json
RUN cd /build/cursor-runner && npx tsc -p tsconfig.build.json

# Reinstall without devDependencies for a lean production node_modules
RUN cd /build/cursor-runner && npm prune --omit=dev

# Verify the build output exists
RUN test -f /build/cursor-runner/dist/main.js && \
    echo "cursor-runner build verification passed"

# ---------- Sandbox Image ----------
FROM debian:bookworm-slim

# Install base utilities and MCP server runtimes
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    git \
    ca-certificates \
    jq \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Install Python3, pip, yamllint
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    yamllint \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/*

# Node.js 22 LTS — required by Cursor SDK (>=20) and used for MCP server
# runtimes (npx). Copied from the official Node.js image instead of using
# Debian's package (which ships v18 on bookworm).
COPY --from=public.ecr.aws/docker/library/node:22-slim /usr/local/bin/node /usr/local/bin/node
COPY --from=public.ecr.aws/docker/library/node:22-slim /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -sf /usr/local/bin/node /usr/local/bin/nodejs \
    && ln -sf /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -sf /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

# Install PyYAML globally
RUN pip3 install --no-cache-dir pyyaml --break-system-packages

# Go toolchain (for 'go run' of Go-based MCP servers: Stigmer, Planton, GitHub, etc.)
COPY --from=public.ecr.aws/docker/library/golang:1.25 /usr/local/go /usr/local/go
ENV PATH="/usr/local/go/bin:${PATH}"
ENV GOPATH="/root/go"
ENV PATH="${GOPATH}/bin:${PATH}"

# uv / uvx (Python package runner — the PyPI equivalent of npx)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

# Install yq (YAML processor)
RUN YQ_VERSION=v4.40.5 && \
    wget -qO /usr/local/bin/yq https://github.com/mikefarah/yq/releases/download/${YQ_VERSION}/yq_linux_amd64 && \
    chmod +x /usr/local/bin/yq

# ---------- Agent Runner ----------
# Baked in per DD01: the runner IS the sandbox. stigmer-service starts the
# worker process via sandbox.process.exec() after sandbox creation.
COPY backend/services/agent-runner/ /app/
COPY backend/libs/python/graphton /app/backend/libs/python/graphton
COPY apis/stubs/python /app/apis/stubs/python
COPY --from=runner-builder /app/backend/services/agent-runner/.venv /app/.venv

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH="/app/src"

# Verify agent-runner dependencies are importable in the final image.
RUN cd /app && /app/.venv/bin/python -c "\
from stigmer_runner.worker.config import Config; \
from deepagents.middleware.subagents import SubAgentMiddleware; \
print('agent-runner import verification passed')"

# ---------- Cursor Runner ----------
# Compiled JS + production node_modules from the builder stage.
# stigmer-service starts this worker via sandbox.process.exec() when
# the session harness is HARNESS_CURSOR.
COPY --from=cursor-runner-builder /build/cursor-runner/dist /cursor-runner/dist
COPY --from=cursor-runner-builder /build/cursor-runner/node_modules /cursor-runner/node_modules
COPY --from=cursor-runner-builder /build/cursor-runner/package.json /cursor-runner/package.json

# Proto stubs required by cursor-runner. npm resolves the file: dependency
# (@stigmer/protos) as a symlink into node_modules; the symlink target must
# exist in the final image for Node.js module resolution to work.
COPY --from=cursor-runner-builder /build/apis/stubs/ts /apis/stubs/ts

# Verify cursor-runner is importable in the final image.
# Tests the full import chain: main -> worker -> execute-cursor -> @stigmer/protos
# and @temporalio/worker (native Rust bindings). The previous config-only check
# missed the dangling @stigmer/protos symlink that crashed the runner at startup.
RUN node --input-type=module -e "\
import { NativeConnection } from '@temporalio/worker'; \
import '/cursor-runner/dist/config.js'; \
import '/cursor-runner/dist/activity/execute-cursor.js'; \
console.log('cursor-runner import verification passed')"

# Set working directory (Daytona convention — user workspace, not runner code)
WORKDIR /workspace

# Verify MCP runtimes and core utilities
RUN git --version && \
    python3 --version && \
    python --version && \
    pip3 --version && \
    node --version && \
    npm --version && \
    go version && \
    uv --version && \
    uvx --version && \
    jq --version && \
    yq --version && \
    yamllint --version && \
    /app/.venv/bin/python --version

CMD ["/bin/bash"]
