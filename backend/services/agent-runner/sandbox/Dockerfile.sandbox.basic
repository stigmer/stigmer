# Basic Sandbox (~500MB)
# Python + Node + Go + uv/uvx + Git — all MCP server runtimes included
#
# Covers the three MCP server distribution methods:
#   npx    — npm packages      (e.g., npx @modelcontextprotocol/server-github)
#   uvx    — Python packages   (e.g., uvx mcp-server-sqlite)
#   go run — Go modules        (e.g., go run github.com/org/mcp-server@latest)
#
# Use this for:
# - Daytona sandboxes (default image for agent execution)
# - CI/CD pipelines
# - Quick testing in clean environment

FROM python:3.11-slim

# Install base utilities and development tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Core utilities
    git \
    curl \
    wget \
    ca-certificates \
    jq \
    bash \
    # Build tools for Python packages
    build-essential \
    # Node.js and npm
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Verify Node.js installation
RUN node --version && npm --version

# Go toolchain (for 'go run' of Go-based MCP servers)
COPY --from=public.ecr.aws/docker/library/golang:1.25 /usr/local/go /usr/local/go
ENV PATH="/usr/local/go/bin:${PATH}"

# uv / uvx (Python package runner — the PyPI equivalent of npx)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

# Set working directory
WORKDIR /workspace

# Copy and install Python requirements
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt && \
    rm /tmp/requirements.txt

# Create non-root user for security (UID 1000 = standard first non-privileged user)
RUN groupadd -g 1000 sandbox && \
    useradd -r -u 1000 -g sandbox -m sandbox && \
    mkdir -p /home/sandbox/go && \
    chown -R sandbox:sandbox /workspace /home/sandbox/go

ENV GOPATH="/home/sandbox/go"
ENV PATH="${GOPATH}/bin:${PATH}"

# Switch to non-root user
USER sandbox

# Verify all runtimes are available under the non-root user
RUN python --version && \
    pip --version && \
    node --version && \
    npm --version && \
    npx --version && \
    go version && \
    uv --version && \
    uvx --version && \
    git --version && \
    curl --version && \
    jq --version

# Default command
CMD ["/bin/bash"]
