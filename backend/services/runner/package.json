{
  "name": "@stigmer/runner",
  "version": "0.0.0-dev",
  "description": "Embeddable Temporal worker for the Stigmer AI agent platform — handles agent execution, workflow orchestration, and MCP server management",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=23.4.0"
  },
  "bin": {
    "stigmer-runner": "./dist/main.js"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./cli": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js",
      "default": "./src/main.ts"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/build-fingerprint.js",
    "build:slim": "npm run build && node scripts/bundle-slim.mjs",
    "verify:slim": "node scripts/verify-slim-artifact.mjs",
    "verify:dist": "node scripts/verify-dist-boot.mjs",
    "verify:consumer": "node scripts/verify-consumer-install.mjs",
    "gen:ipc-fixtures": "tsx scripts/generate-ipc-fixtures.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-deps": "bash scripts/check-langchain-deps.sh",
    "clean": "rm -rf dist dist-slim"
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "stigmer",
    "runner",
    "temporal",
    "ai-agents",
    "cursor-sdk",
    "deepagents"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./cli": {
        "types": "./dist/main.d.ts",
        "import": "./dist/main.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stigmer/stigmer.git",
    "directory": "backend/services/runner"
  },
  "overrides": {
    "@anthropic-ai/sdk": "0.116.0"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.32.1",
    "@anthropic-ai/foundry-sdk": "^0.4.1",
    "@anthropic-ai/vertex-sdk": "^0.19.1",
    "@azure/identity": "^4.13.1",
    "@bufbuild/protobuf": "2.12.0",
    "@connectrpc/connect": "^2.0.0",
    "@connectrpc/connect-node": "^2.0.0",
    "@cursor/sdk": "^1.0.13",
    "@langchain/anthropic": "^1.5.5",
    "@langchain/core": "^1.2.7",
    "@langchain/langgraph": "^1.3.0",
    "@langchain/mcp-adapters": "^1.1.3",
    "@langchain/openai": "^1.4.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^2.0.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.218.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.218.0",
    "@opentelemetry/resources": "^2.0.0",
    "@opentelemetry/sdk-metrics": "^2.0.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "@opentelemetry/sdk-trace-node": "^2.0.0",
    "@stigmer/protos": "file:../../../apis/stubs/ts",
    "@stigmer/temporal-codecs": "file:../../libs/ts/temporal-codecs",
    "@stigmer/zip-structure": "file:../../libs/ts/zip-structure",
    "@temporalio/activity": "1.16.2",
    "@temporalio/common": "1.16.2",
    "@temporalio/interceptors-opentelemetry": "1.16.2",
    "@temporalio/proto": "1.16.2",
    "@temporalio/worker": "1.16.2",
    "@temporalio/workflow": "1.16.2",
    "deepagents": "1.10.2",
    "diff": "^8.0.4",
    "jq-wasm": "^1.1.0-jq-1.8.1",
    "js-yaml": "^4.1.1",
    "proper-lockfile": "^4.1.2",
    "semver": "^7.8.0",
    "turndown": "^7.2.4",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "devDependencies": {
    "@temporalio/testing": "1.16.2",
    "@types/js-yaml": "^4.0.9",
    "@types/proper-lockfile": "^4.1.4",
    "@types/semver": "^7.7.1",
    "@types/turndown": "^5.0.6",
    "esbuild": "^0.28.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
