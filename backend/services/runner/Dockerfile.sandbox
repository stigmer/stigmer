# The Sandbox Runner — Base Image, Runner Layer, Sandbox + Compose Images
#
# Build context: Repository root
# Build commands:
#   the cloud sandbox image:
#     docker build --target sandbox -f backend/services/runner/Dockerfile.sandbox .
#   the default base image alone (the agent's tools, no runner):
#     docker build --target base -f backend/services/runner/Dockerfile.sandbox .
#   the compose runner (stage the CLI first; see the compose-runner stage):
#     node scripts/stage-compose-runner-cli.mjs
#     docker build --build-arg STIGMER_CLI_VERSION=$(cat backend/services/runner/stage/cli/VERSION) \
#       -f backend/services/runner/Dockerfile.sandbox .
#
# A sandbox image is two things with two owners, joined:
#
#   the base image   — what an agent's shell has: the OS, its tools, a Node
#                      for agents. The `base` stage is Stigmer's default; it
#                      holds nothing of the runner.
#   the runner layer — Stigmer's runner and the Node that runs it, all under
#                      /runner, nothing anywhere else: /runner/bin/node, and
#                      /runner/dist, the slim runner artifact
#                      (scripts/bundle-slim.mjs) as its self-contained
#                      directory, node_modules inside it. The entries keep
#                      the paths every driver launches: /runner/dist/main.js
#                      (the runner) and /runner/dist/attach/main.js (the
#                      attach waiter); the launch commands live once, in the
#                      server's src/sandbox/runner-launch.ts.
#
# The runner's Node is never on the agent's PATH: the drivers start it by
# absolute path, and the agent's `node` is the base's own, so a runner Node
# upgrade is never a change an agent's commands can see. Both are the
# repository's .nvmrc version (scripts/dockerfile-node-pin.test.mjs).
#
# Stages:
#
#   node-runtime   — the pinned official Node image, by multi-arch digest
#   base           — the default base image
#   libs           — builds the runner's file:-linked @stigmer libs
#   builder        — compiles the runner and bundles the slim artifact for
#                    this build's platform (its @cursor/sdk platform package
#                    is the one npm installed here, so each arch's leg
#                    builds its own)
#   runner-layer   — FROM scratch, /runner only
#   sandbox        — base plus the runner layer's three layers. The
#                    CLOUD sandbox image (release.sandbox-cloud builds
#                    `--target sandbox`). The runner process is started by
#                    the control plane (the drivers set the command), so CMD
#                    stays /bin/bash and an ad-hoc `docker run` lands in a
#                    shell.
#   compose-runner — the SELF-HOST compose stack's runner (the default,
#                    last stage; docker-compose.yml consumes it as
#                    ghcr.io/stigmer/stigmer-runner). Compose is this
#                    image's control plane, so the runner launch command is
#                    baked in, and the stigmer CLI rides along for the
#                    OSS-shape MCP attachments (see the stage comment).
#
# The base provides the agent's tools: Node.js (npm, npx), Python (pip, venv,
# uv), Go, git, curl, wget, jq, yq, unzip, yamllint and ripgrep. Stdio MCP
# servers do NOT run on cloud runners (stdio is local-runner-only; see
# shared/mcp-transport-guard.ts), so no MCP package caches are pre-warmed.
# The runtimes stay because agents legitimately shell out to node/python/go
# in their workspaces. The compose runner runs MODE=local, where stdio MCP
# IS allowed — its subprocesses spawn inside this container. ripgrep is the
# native agent's grep tool's engine (deepagents spawns `rg`; without it the
# tool falls back to a substring search).
#
# Layers are cut by owner, so a node already holding one build pulls only
# what the next one changed (stigmer/stigmer#1244: every build used to be
# 372 of 400 MB new bytes): the base's layers change only when its tools do,
# and a runner-only release changes the one runner layer.
#
# Platforms: linux/amd64 + linux/arm64. The slim artifact is glibc-only
# (bundle-slim.mjs's native triples), so a base must be glibc too. The only
# arch-named asset in `base` is the yq download, parameterized below.

# The official Node image at the .nvmrc version, by its multi-arch index
# digest: the runner's Node and the agent's come from here, never from a
# floating tag.
FROM node:22.22.1-bookworm-slim@sha256:4f77a690f2f8946ab16fe1e791a3ac0667ae1c3575c3e4d0d4589e9ed5bfaf3d AS node-runtime

# ---------- The default base image ----------
FROM debian:bookworm-slim AS base

# TARGETARCH (amd64|arm64) is populated by BuildKit per platform leg —
# needed by the yq download below, which is the only arch-named asset in
# this stage (node/go/uv all resolve their arch via multi-arch images or
# installer detection).
ARG TARGETARCH

# --- Node.js for agents (Debian's is v18), with npm and npx ---
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node-runtime /usr/local/lib/node_modules/ /usr/local/lib/node_modules/
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && \
    ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

# --- System packages ---
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        jq \
        unzip \
        wget \
        python3 \
        python3-pip \
        python3-venv \
        ripgrep \
        yamllint \
    && rm -rf /var/lib/apt/lists/*

# --- Go 1.25 toolchain (for MCP servers via `go run`) ---
COPY --from=golang:1.25-bookworm /usr/local/go /usr/local/go
ENV PATH="/usr/local/go/bin:${PATH}"

# Tool versions are pinned so a cached layer is never silently stale and an
# upgrade is a reviewed one-line change (an unpinned download made every
# build a different layer, and a cached one would never update).
ARG UV_VERSION=0.12.18
ARG YQ_VERSION=v4.53.6

# --- uv / uvx (Python package runner for MCP servers) ---
RUN curl -LsSf "https://astral.sh/uv/${UV_VERSION}/install.sh" | sh && \
    mv /root/.local/bin/uv /usr/local/bin/uv && \
    mv /root/.local/bin/uvx /usr/local/bin/uvx

# --- yq (YAML processor) ---
RUN curl -fsSL "https://github.com/mikefarah/yq/releases/download/${YQ_VERSION}/yq_linux_${TARGETARCH}" \
        -o /usr/local/bin/yq && \
    chmod +x /usr/local/bin/yq

WORKDIR /workspace

CMD ["/bin/bash"]

# ---------- The @stigmer/* file: dependencies, built ----------
FROM node-runtime AS libs

WORKDIR /build

# Build @stigmer/protos (file: dependency of the runner).
# Proto stubs have no lock file — single dependency (@bufbuild/protobuf).
COPY apis/stubs/ts/package.json apis/stubs/ts/
RUN cd apis/stubs/ts && npm install --ignore-scripts
COPY apis/stubs/ts/ apis/stubs/ts/
RUN cd apis/stubs/ts && npm run build

# Build @stigmer/temporal-codecs (file: dependency of the runner) — the
# shared Temporal payload-codec lib extracted from the runner. Same
# treatment as the proto stubs: install, copy source, build dist.
COPY backend/libs/ts/temporal-codecs/package.json backend/libs/ts/temporal-codecs/
RUN cd backend/libs/ts/temporal-codecs && npm install --ignore-scripts
COPY backend/libs/ts/temporal-codecs/ backend/libs/ts/temporal-codecs/
RUN cd backend/libs/ts/temporal-codecs && npm run build

# Build @stigmer/zip-structure (file: dependency of the runner) — the
# shared structural ZIP parsing lib extracted from the runner. Same
# treatment as the other libs: install, copy source, build dist.
COPY backend/libs/ts/zip-structure/package.json backend/libs/ts/zip-structure/
RUN cd backend/libs/ts/zip-structure && npm install --ignore-scripts
COPY backend/libs/ts/zip-structure/ backend/libs/ts/zip-structure/
RUN cd backend/libs/ts/zip-structure && npm run build

# Build @stigmer/outbound (file: dependency of the runner) — the egress
# address policy and the MCP OAuth rules the runner shares with the control
# plane. Same treatment as the other libs: install, copy source, build dist.
COPY backend/libs/ts/outbound/package.json backend/libs/ts/outbound/
RUN cd backend/libs/ts/outbound && npm install --ignore-scripts
COPY backend/libs/ts/outbound/ backend/libs/ts/outbound/
RUN cd backend/libs/ts/outbound && npm run build

# ---------- The runner, compiled and bundled ----------
# Built against the real libs (the file: references resolve to libs' tree),
# with every dependency; only the slim artifact leaves this stage, split in
# two by how often each part changes: /build/slim/node_modules (the staged
# packages, which change with the lockfile) and /build/slim/dist (the
# bundles, which change with the runner). Every file's time is set to npm's
# fixed tarball date, so an unchanged dependency tree is the same layer
# bytes build after build and a node holding it pulls only the bundles
# (stigmer/stigmer#1244). Its bundler imports the repository's one rule for
# source-map pragmas, so that file is copied to the path it imports from.
# meta.json is esbuild's build diagnostics, which no runtime reads (the
# desktop's staging skips it too).
FROM libs AS builder

RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ && \
    rm -rf /var/lib/apt/lists/*

COPY scripts/lib/source-map-pragma.mjs /build/scripts/lib/source-map-pragma.mjs
COPY backend/services/runner/package.json backend/services/runner/package-lock.json backend/services/runner/
WORKDIR /build/backend/services/runner
RUN npm ci --legacy-peer-deps

COPY backend/services/runner/ .
RUN npm run build:slim && rm dist-slim/meta.json && \
    mkdir -p /build/slim && mv dist-slim/node_modules /build/slim/node_modules && \
    mv dist-slim /build/slim/dist && \
    find /build/slim -exec touch -h -d 1985-10-26T08:15:00Z {} +

# ---------- The runner layer ----------
# Everything Stigmer adds to a base image, under /runner and nowhere else,
# as three layers ordered by how often they change: the Node binary alone
# (no npm: the runner needs nothing else of it), the staged packages, the
# bundles. Together they are the slim artifact's self-contained directory
# at /runner/dist.
FROM scratch AS runner-layer

COPY --from=node-runtime /usr/local/bin/node /runner/bin/node
COPY --from=builder /build/slim/node_modules/ /runner/dist/node_modules/
COPY --from=builder /build/slim/dist/ /runner/dist/

# ---------- The cloud sandbox image ----------
# The default base plus the runner layer: the same three COPY lines as the
# runner-layer stage (scripts/runner-launch-contract.test.mjs holds them
# equal), so the image keeps the runner layer's three layers rather than
# one, and a runner-only release changes only the bundles.
FROM base AS sandbox

COPY --from=node-runtime /usr/local/bin/node /runner/bin/node
COPY --from=builder /build/slim/node_modules/ /runner/dist/node_modules/
COPY --from=builder /build/slim/dist/ /runner/dist/

# ---------- Compose runner (the self-host stack's runner) ----------
# The sandbox stage plus the stigmer CLI. Why the CLI: in the OSS/local
# shape (no STIGMER_MCP_BRIDGE_ENDPOINT) the runner synthesizes the memory
# and channel MCP attachments as a spawned `stigmer mcp-server` stdio child
# (shared/memory-attachment.ts, shared/channel-attachment.ts). On a laptop
# the CLI is on PATH by definition; in a container it must be baked in, or
# every memory-enabled session fails at spawn (ENOENT).
#
# Where the CLI comes from: the build context, never the registry. The
# build that produces this image has already built the CLI from the same
# commit; scripts/stage-compose-runner-cli.mjs packs it and its @stigmer/*
# closure into stage/cli/pkgs/ with the same stamped dist/ the registry
# receives (publish-libs.mjs --pack-dir --only @stigmer/cli). Installing
# from the registry instead raced its replication: the release lane
# published @stigmer/cli and asked for it seconds later, and lost on three
# consecutive releases (stigmer/stigmer#1158). From tarballs the image's
# CLI is provably this commit's, a PR's compose smoke tests the PR's own
# CLI rather than the last release's, and no build step waits on npm.
#
# One `npm install` of all the tarballs into one prefix, the all-in-one
# image's mechanism (deploy/all-in-one/Dockerfile): npm resolves every
# @stigmer/* edge among the given tarballs and fetches only third-party
# deps. NOT `npm install -g`: a global install nests each top-level
# package's tree separately, so the CLI's edge to @stigmer/sdk would be
# fetched from the registry — the race, one layer down. The `.bin` of the
# prefix goes on PATH, which is where the runner's spawn looks.
#
# STIGMER_CLI_VERSION is the version the staged tarballs were stamped with
# (stage/cli/VERSION); the build asserts the installed CLI reports it so
# a stale stage or a mismatched artifact fails here, not in a session.
FROM sandbox AS compose-runner

ARG STIGMER_CLI_VERSION
ENV STIGMER_CLI_PREFIX=/opt/stigmer/cli

COPY backend/services/runner/stage/cli/pkgs/ /tmp/stigmer-cli-pkgs/
RUN test -n "${STIGMER_CLI_VERSION}" || { echo "STIGMER_CLI_VERSION build-arg is required (backend/services/runner/stage/cli/VERSION)" >&2; exit 1; } \
    && npm install --prefix "${STIGMER_CLI_PREFIX}" --omit=dev --no-audit --no-fund /tmp/stigmer-cli-pkgs/*.tgz \
    && installed="$(node -p "require('${STIGMER_CLI_PREFIX}/node_modules/@stigmer/cli/package.json').version")" \
    && test "${installed}" = "${STIGMER_CLI_VERSION}" || { echo "staged CLI is ${installed}, build-arg says ${STIGMER_CLI_VERSION}" >&2; exit 1; } \
    && rm -rf /tmp/stigmer-cli-pkgs /root/.npm
ENV PATH="${STIGMER_CLI_PREFIX}/node_modules/.bin:${PATH}"

# State home. The runner keeps session state — HITL/pause checkpoints
# (sessions/<id>/checkpoints.db), the HITL gate dir — under $HOME/.stigmer
# (shared/workspace/platform-dir.ts). /data mirrors the server image's
# HOME=/data posture so compose can pin ONE volume mount point per
# container; without it, in-flight paused sessions die with the container.
#
# The artifact path is pre-created uid/gid 1000 — the SERVER image's
# non-root `node` user. Compose mounts one shared artifacts volume into
# both containers at this path, and docker initializes a named volume from
# whichever container mounts it FIRST: if that is this (root-running)
# image and the path were root-owned, the non-root server could never
# write an artifact. Pinning 1000 here makes initialization order
# irrelevant; the runner itself runs as root and reads regardless.
RUN mkdir -p /data/.stigmer/data/artifacts && chown -R 1000:1000 /data/.stigmer/data/artifacts
ENV HOME=/data

# Compose is this image's control plane (the sandbox header's contract),
# so the launch command is baked here rather than repeated in every
# compose file: the server's runner launch command (src/sandbox/runner-launch.ts,
# whose test pins this line to it), the runner's own Node by absolute path.
CMD ["/runner/bin/node", "/runner/dist/main.js"]
