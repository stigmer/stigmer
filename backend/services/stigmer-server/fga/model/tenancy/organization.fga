module tenancy

# ========================================
# ORGANIZATION TYPE (Root-level Resource)
# ========================================
# Organizations are top-level containers for resources. An organization
# may have a parent organization (spec.parent_org), one level deep: a child
# organization, such as the organization an integrator runs for one of its
# customers. The creator of an organization becomes its owner; a child has
# no creator owner: its parent's admins are its admins (parent_admin), the
# way a Stripe platform administers its connected accounts.
#
# Permission hierarchy: owner > admin > member > viewer
#
# Platform operators hold no relation on an organization: a platform act
# is an explicit permission on platform:stigmer (platform.fga), never a
# transitive path into organizations.
#
# FGA tuples on org creation:
# - organization:acme#owner@identity_account:alice
# and on a child's creation, both edges and no owner:
# - organization:acme-cust#parent_org@organization:acme
# - organization:acme#child_org@organization:acme-cust
# and while spec.policies lets members create agents (the default):
# - organization:acme#agent_creation_open@organization:acme

type organization
  relations
    # ========================================
    # ORGANIZATIONAL ROLES
    # ========================================
    # Organization owner (creator)
    # FGA tuple: organization:<org_id>#owner@identity_account:<user_id>
    define owner: [identity_account]
    
    # Organization admins (can manage org settings and members), and on a
    # child organization its parent's admins (parent_admin below).
    # FGA tuple: organization:<org_id>#admin@identity_account:<user_id>
    define admin: [identity_account] or owner or parent_admin
    
    # Organization members (users with access to org resources)
    # FGA tuple: organization:<org_id>#member@identity_account:<user_id>
    define member: [identity_account] or admin
    
    # Organization viewers (read-only access, the organization's billing
    # included: can_view_billing is viewer's)
    # FGA tuple: organization:<org_id>#viewer@identity_account:<user_id>
    define viewer: [identity_account] or member

    # Anonymous shared-agent visitors (one identity account per org).
    # Grants session/run creation only — not member/viewer inheritance.
    # FGA tuple: organization:<org_id>#guest@identity_account:<guest_account_id>
    define guest: [identity_account]
    # Anyone who holds a role in the organization, a guest included, and
    # on a child organization its parent's admins: the bound every
    # organization-scoped type puts on its direct grants
    # (`[identity_account] and affiliated from organization`). A person
    # who loses their last role here (or a parent admin who stops being
    # one) reaches nothing the organization holds on the next check,
    # however the grant was made (shared with them, authored by them, or
    # through a team), with no cleanup to wait for. A guest is included
    # because the organization's system accounts (guest, channel and
    # schedule sessions) hold `guest` and own the sessions they create.
    #
    # Two halves. The stored half costs one read instead of a walk up the
    # role chain on every object a list checks. It is DERIVED, never
    # granted: exactly while the person holds at least one role row on the
    # organization. The grant path refuses it as a grant and announces
    # every change of a person's organization rows; an edition that stores
    # tuples writes and removes it from those announcements, and open
    # source derives it from the rows at check time. The computed half
    # (parent_admin) is walked only when the stored half misses: one read
    # of the organization's parent_org, empty for an organization with no
    # parent.
    # FGA tuple: organization:<org_id>#affiliated@identity_account:<user_id>
    define affiliated: [identity_account] or parent_admin

    # ========================================
    # PARENT AND CHILD ORGANIZATIONS
    # ========================================
    # A child organization names its parent; both edges are written once,
    # when the child is created, and never change (spec.parent_org is
    # fixed). One level deep: a child has no children.
    # FGA tuple: organization:<child>#parent_org@organization:<parent>
    define parent_org: [organization]
    # The reverse edge, on the parent.
    # FGA tuple: organization:<parent>#child_org@organization:<child>
    define child_org: [organization]
    # Everyone who holds a role in any child: the audience of a blueprint
    # shared at visibility_child_orgs, which names this userset.
    define child_org_viewer: viewer from child_org
    # The parent's admins, on a child: admins of the child (admin above),
    # inside its membership bound (affiliated above), so they read and
    # change what the child holds as its own admins do. A person's
    # sessions, My vault and memories stay theirs alone, here as in every
    # organization (session.fga, vault.fga, memory.fga). Besides admin,
    # the parent's admins keep deleting the child and making its owner.
    #
    # The first relation in the model that recurses through another object
    # of the same type (admin -> parent_admin -> admin from parent_org).
    # It ends at the parent, which has no parent_org: one level deep, and
    # the create refuses a parent that is itself a child.
    define parent_admin: admin from parent_org

    # ========================================
    # POLICIES (spec.policies)
    # ========================================
    # An edge from the organization to itself, present exactly while its
    # policy "Members can create agents" is on (the default). Written and
    # removed only by the organization's create and updatePolicies, never
    # granted; open source derives it from the row at check time. Not a
    # cycle: member never reads it.
    # FGA tuple: organization:<org_id>#agent_creation_open@organization:<org_id>
    define agent_creation_open: [organization]
    
    # ========================================
    # CRUD OPERATIONS
    # ========================================
    define can_view: viewer
    # The organization itself (OrganizationQueryController.get): every role.
    define can_view_settings: can_view
    define can_edit: admin
    # A child has no owner; its parent's admins delete it.
    define can_delete: owner or parent_admin
    
    # ========================================
    # MEMBER MANAGEMENT
    # ========================================
    # Granting, revoking or removing the owner role. The Grant lanes and
    # the invitation lane ask it whenever a change touches owner, on top of
    # can_grant_access: an admin grants every role up to admin, and only an
    # owner makes an owner (on a child, which has none, the parent's
    # admins).
    define can_assign_roles: owner or parent_admin
    
    # ========================================
    # RESOURCE CREATION PERMISSIONS
    # ========================================
    # Admins always; members while the organization's policy lets them.
    define can_create_agent: admin or member from agent_creation_open
    define can_create_session: member or guest
    # Every member keeps a My vault of their own logins and secrets; a
    # shared vault is the organization's, so only admins create one.
    define can_create_vault: member
    define can_create_shared_vault: admin
    define can_create_skill: admin
    # A plugin install writes several resources in one act — the skill bar.
    define can_create_plugin: admin
    # An eval is an agent's tests: whoever may build agents may write them.
    define can_create_eval: can_create_agent
    define can_create_federation_issuer: admin
    define can_create_identity_account: admin
    define can_create_oauth_app: admin
    # Channel apps hold org-wide webhook + OAuth credentials — admin-gated
    # like can_create_oauth_app.
    define can_create_channel_app: admin
    define can_create_run_in: member or guest
    # Asked on every agent share create, beside can_manage_audience on the
    # shared agent: a share spends on THIS org's own provider keys for the
    # open internet, an admin-level act, whichever agent it offers. A share's agent lives in
    # the share's own organization since the public level retired
    # (stigmer#1211), so the two questions are always one organization's.
    define can_create_agent_share: admin
    # Asked on every agent channel create, beside can_manage_audience on the
    # connected agent, the share's bar: a channel spends on THIS org's own
    # provider keys for outside traffic, an admin-level act, whichever agent
    # it serves. A
    # member owns the agents they create (can_create_agent), so ownership
    # alone must not connect one.
    define can_create_agent_channel: admin
    # Teams are the organization's, managed by its admins (team.fga).
    define can_create_team: admin
    # Creating, finding and listing the organization's children. A child's
    # admins (its parent's included) hold it too and cannot use it: a
    # child has no children.
    define can_manage_child_orgs: admin
    # Minting a user token for the organization (TokenService.mintUserToken):
    # it can create a person's account and grant them the embedding
    # sign-in role, an administrator's act, so its admins (the parent's
    # included) hold it, and a service account's key mints only when its
    # account does. The mint refuses every caller but a service account.
    define can_mint_user_tokens: admin
    
    # ========================================
    # ACCESS MANAGEMENT
    # ========================================
    define can_grant_access: admin
    define can_view_access: viewer
    # The record of every grant and removal: read by those who manage
    # access, not by everyone who can see who has it.
    define can_view_access_history: admin
    
    # ========================================
    # BILLING PERMISSIONS
    # ========================================
    # A child's billing is its parent's admins' to see and manage too.
    define can_view_billing: viewer
    define can_manage_billing: admin
