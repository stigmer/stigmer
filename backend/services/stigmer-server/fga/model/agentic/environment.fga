module agentic

# ========================================
# ENVIRONMENT TYPE (Organization-scoped)
# ========================================
# A named sandbox setup: the packages a conversation's sandboxes get and
# the websites they may reach. Every Environment belongs to an
# organization, and only its admins create one (can_create_environment).
# Visibility is handled entirely through FGA tuples written by
# VisibilityTupleReconciler, across three levels (private / org /
# child_orgs), exactly as for skills (skill.fga, agent.fga for the full
# pattern docs).
#
# Authorization model (visibility is REAL — no unconditional org grant):
# - PRIVATE: owner (incl. org admins, see below) + explicit grants only.
# - ORG and above: org members can view it, and so name it for a
#   conversation, a routine or an agent (the reference rule asks can_view
#   of whoever writes the reference).
# - Owners (creators) and org admins can edit/delete (admin inheritance).
#
# FGA tuples on creation:
# - environment:<id>#organization@organization:<org>
# - environment:<id>#owner@identity_account:alice
# - environment:<id>#viewer@organization:<org>#viewer (if visibility>=ORG)
# - environment:<id>#child_org_viewer@organization:<org>#child_org_viewer (if visibility=CHILD_ORGS)

type environment
  relations
    # ========================================
    # ORGANIZATION OWNERSHIP
    # ========================================
    # Structural link only for viewer access — org ADMINS still inherit
    # owner through it (see owner below), so a private Environment remains
    # manageable by org admins while invisible to plain members.
    define organization: [organization]
    
    # ========================================
    # OWNERSHIP (Attribution + Admin)
    # ========================================
    define owner: ([identity_account] and affiliated from organization) or admin from organization
    
    # ========================================
    # CHILD-ORGANIZATION VISIBILITY (Structural)
    # ========================================
    # Everyone in every child organization of the owning organization.
    # FGA tuple: environment:<id>#child_org_viewer@organization:<org_id>#child_org_viewer
    define child_org_viewer: [organization#child_org_viewer]
    
    # ========================================
    # VIEWER ACCESS
    # ========================================
    # organization#viewer is the shape VisibilityTupleReconciler writes — the
    # org's FULL read audience (roles flow downward: owner/admin/member all
    # satisfy organization#viewer); a narrower role's userset is refused
    # (README, "Shapes to Avoid"). team#member is an Enterprise team's
    # grant: every member, bounded by the organization in team.fga.
    define viewer: ([identity_account, organization#viewer, team#member] and affiliated from organization) or owner or child_org_viewer
    
    # ========================================
    # PERMISSIONS
    # ========================================
    define can_view: viewer
    define can_edit: owner
    define can_delete: owner
    
    # ========================================
    # ACCESS MANAGEMENT
    # ========================================
    define can_grant_access: owner
    
    # ========================================
    # AUDIENCE
    # ========================================
    # Who reaches this Environment (visibility) is its owner's to change.
    # Kept apart from can_grant_access, which the self-check answers false
    # wherever the edition grants no roles on the kind: the audience is the
    # owner's in every edition. An editor never holds it.
    define can_manage_audience: owner
    define can_view_access: viewer
