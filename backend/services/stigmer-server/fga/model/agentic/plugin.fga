module agentic

# ========================================
# PLUGIN TYPE (Organization-scoped)
# ========================================
# The unit of install: an Agent Plugins package holding skills, agents,
# hooks and MCP servers, which agents and conversations list whole. It is a
# blueprint-shaped kind
# and follows the skill model exactly: org-scoped, owner-attributed, four
# visibility levels through the tuples VisibilityTupleReconciler writes
# (see agent.fga for the pattern, including the org floor).
#
# A plugin is one resource: install writes it and nothing else, so its
# skills, agents, hooks and servers are reached through the plugin's own
# relations. `can_view` lets a member list it on an agent or a
# conversation, and check its servers' tools; `can_edit` gates push
# (upgrade) and updateVisibility; `can_delete` gates removal.
#
# Authorization model (visibility is REAL — no unconditional org grant):
# - PRIVATE: owner (incl. org admins, see below) + explicit grants only.
# - ORG and above: org members can view/use via the explicit viewer tuple.
# - Owners (installers) and org admins can upgrade/re-level/remove (admin
#   inheritance — mirrors skill and agent).
#
# FGA tuples on install:
# - plugin:thermos#organization@organization:stigmer
# - plugin:thermos#owner@identity_account:alice
# - plugin:thermos#viewer@organization:stigmer#viewer (if visibility>=ORG)
# - plugin:thermos#child_org_viewer@organization:<org>#child_org_viewer (if visibility=CHILD_ORGS)

type plugin
  relations
    # ========================================
    # ORGANIZATION OWNERSHIP
    # ========================================
    define organization: [organization]

    # ========================================
    # OWNERSHIP (Attribution + Admin)
    # ========================================
    define owner: ([identity_account] and affiliated from organization) or admin from organization

    # ========================================
    # CHILD-ORGANIZATION VISIBILITY (Structural)
    # ========================================
    define child_org_viewer: [organization#child_org_viewer]

    # ========================================
    # VIEWER ACCESS
    # ========================================
    # team#member is an Enterprise team's grant: every member, bounded by
    # the organization in team.fga.
    define viewer: ([identity_account, organization#viewer, team#member] and affiliated from organization) or owner or child_org_viewer

    # ========================================
    # PERMISSIONS
    # ========================================
    define can_view: viewer
    define can_edit: owner
    define can_delete: owner

    # ========================================
    # IAM POLICY MANAGEMENT
    # ========================================
    define can_grant_access: owner
    
    # ========================================
    # AUDIENCE
    # ========================================
    # Who reaches this plugin (visibility) is its owner's to change.
    # Kept apart from can_grant_access, which the self-check answers false
    # wherever the edition grants no roles on the kind: the audience is the
    # owner's in every edition. An editor never holds it.
    define can_manage_audience: owner
    define can_view_access: viewer
