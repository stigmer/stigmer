module agentic

# ========================================
# EVALUATOR TYPE (Agent-bound)
# ========================================
# AI grading switched on for one agent: its sample rate, monthly spending
# limit and judge model.
#
# Authorization model:
# - Access is the agent's: whoever may edit the agent configures, pauses
#   and deletes its grading; whoever may view the agent sees the settings
#   and this month's spend, members of child organizations included when
#   the agent is shared with them. Nothing is granted on an evaluator itself (the
#   kind has no visibility block and no grantable roles).
# - No owner of its own (OWNER_ATTRIBUTION_TYPE_NONE). The agent's owner
#   already includes the organization's admins, who hold the purse the
#   grading spends.

type evaluator
  relations
    # ========================================
    # PARENT AGENT
    # ========================================
    # FGA tuple: evaluator:<evaluator_id>#agent@agent:<agent_id>
    define agent: [agent]

    # ========================================
    # OPERATIONS
    # ========================================
    define can_view: can_view from agent
    define can_edit: can_edit from agent
    define can_delete: can_edit from agent
