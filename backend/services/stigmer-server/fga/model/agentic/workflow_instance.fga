module agentic

# ========================================
# WORKFLOW INSTANCE TYPE (Organization-scoped, Configurable Visibility)
# ========================================
# Configured deployments of workflow templates with secrets and configuration.
# Every instance belongs to an organization. Contains encrypted secrets.
#
# Authorization model (CONFIGURABLE VISIBILITY):
# Visibility is controlled by which FGA tuples are written on the viewer
# relation, not by a field in the resource. The model accepts multiple
# principal types so the application layer can set the appropriate level:
#
#   PRIVATE  — no viewer tuples beyond owner. Only owner can access.
#   ORG      — workflow_instance#viewer@organization:<org>#viewer tuple written.
#              Everyone in the org gets viewer access (all roles satisfy
#              organization#viewer; #member is the legacy pre-2026-08-11 shape).
#
# IMPORTANT — instance visibility does NOT imply run visibility:
# The `viewer` relation governs who can SEE and RUN this instance. It does
# NOT govern who can read its executions' inputs/outputs. Workflow executions
# inherit run visibility from the SEPARATE `execution_viewer` relation below,
# so making an instance org-runnable (ORG visibility) never exposes other
# users' run history. See workflow_execution.fga for the inheritance.
#
# Run observability is opt-in and off by default:
# - PRIVATE/ORG instance, no execution_viewer tuples → each execution
#   is visible only to the user who triggered it (its owner).
# - To share run history org-wide, write execution_viewer@organization:<org>#viewer.
#
# DEFAULT instances are different — structural inheritance, not tuples:
# Every workflow has exactly one system-managed default instance (the empty
# config shell the runner resolves when a user has no personal instance).
# Its access must always be EXACTLY the parent workflow's access — private,
# org, or platform — or entitled users are denied mid-execution.
# Rather than copying the parent's visibility enum onto the instance (which
# drifts and needs cascades/migrations on every parent change), the default
# instance carries a single `default_of` tuple and inherits `viewer` from
# the workflow structurally. The enum-driven visibility tuples above are
# NEVER written for default instances. Run observability stays opt-in via
# execution_viewer regardless (independent of instance reachability).
#
# Parent relationship:
# - Every instance is created from a Workflow (the template)
# - The workflow relation tracks this for audit
#
# FGA tuples on creation (always):
# - workflow_instance:<id>#organization@organization:<org>
# - workflow_instance:<id>#workflow@workflow:<workflow>
# - workflow_instance:<id>#owner@identity_account:<creator>
#
# FGA tuples for visibility (conditional, user-created instances only):
# - ORG:    workflow_instance:<id>#viewer@organization:<org>#viewer
#
# FGA tuple for default instances (instead of visibility tuples):
# - workflow_instance:<id>#default_of@workflow:<workflow>
#
# FGA tuples for run observability (opt-in, conditional):
# - ORG runs: workflow_instance:<id>#execution_viewer@organization:<org>#viewer

type workflow_instance
  relations
    # ========================================
    # ORGANIZATION OWNERSHIP
    # ========================================
    define organization: [organization]
    
    # ========================================
    # PARENT WORKFLOW
    # ========================================
    define workflow: [workflow]

    # ========================================
    # DEFAULT-INSTANCE LINK (Structural Inheritance)
    # ========================================
    # Written ONLY on the workflow's one system-managed default instance —
    # invariant: this tuple exists iff workflow.status.defaultInstanceId
    # points at this instance. It makes the default instance exactly as
    # reachable as its template: org members and platform users
    # (identity_provider#platform_user via the workflow's
    # platform_viewer) all inherit viewer through the workflow's own viewer
    # relation. Never written on user-created instances — that would leak
    # personal configuration to everyone who can see the workflow. Distinct
    # from `workflow` above, which is written on EVERY instance purely for
    # parent tracking.
    define default_of: [workflow]
    
    # ========================================
    # OWNERSHIP (Personal Resource)
    # ========================================
    # Org admins explicitly excluded — workflow instances are personal resources
    # containing secrets and configuration that admins have no business accessing.
    define owner: [identity_account]
    
    # ========================================
    # VIEWER ACCESS (Configurable Visibility)
    # ========================================
    # Accepts multiple principal types so visibility can be set per-instance:
    # - identity_account: explicit individual grants
    # - organization#viewer: everyone in the org (ORG visibility — the shape
    #   written since 2026-08-11; every role satisfies it)
    # - organization#member: legacy pre-2026-08-11 ORG shape (kept resolving
    #   until the boot backfill converges stored tuples)
    # - team#member: an Enterprise team's grant, every member, bounded by
    #   the organization in team.fga
    # Default instances additionally inherit the parent workflow's full
    # viewer set through `viewer from default_of` (see default_of above).
    define viewer: [identity_account, organization#member, organization#viewer, team#member] or owner or viewer from default_of
    
    # ========================================
    # RUN OBSERVABILITY (Opt-in, Separate from Visibility)
    # ========================================
    # Opt-in observers of THIS instance's run history. Kept SEPARATE from
    # `viewer` so that making an instance org-runnable (ORG visibility) does
    # NOT expose other users' run inputs/outputs. Empty by default => each
    # workflow_execution stays private to the user who triggered it (its owner).
    # Org-wide run history is granted by writing
    # execution_viewer@organization:<org>#viewer (the org's full read audience;
    # organization#member is the legacy pre-2026-08-11 shape, kept resolving).
    # Consumed by workflow_execution.viewer via "execution_viewer from workflow_instance".
    define execution_viewer: [identity_account, organization#member, organization#viewer]
    
    # ========================================
    # PERMISSIONS
    # ========================================
    define can_view: viewer
    define can_execute: can_view
    define can_edit: owner
    define can_delete: owner
    
    # ========================================
    # IAM POLICY MANAGEMENT
    # ========================================
    define can_grant_access: owner
    define can_view_access: viewer
