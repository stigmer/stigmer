module agentic

# ========================================
# WORKFLOW TYPE (Organization-scoped)
# ========================================
# Workflow definitions (templates) for agent orchestration.
# Every workflow belongs to an organization. Visibility is handled entirely
# through FGA tuples written by VisibilityTupleReconciler, across three
# levels (private / org / platform) — see agent.fga for the full pattern
# docs, including the org floor (PLATFORM also carries the org tuple so
# shared workflows stay listable in their own org).
#
# Authorization model (visibility is REAL — no unconditional org grant):
# - PRIVATE: owner (incl. org admins, see below) + explicit grants only.
# - ORG and above: org members can view/execute via the explicit viewer tuple.
# - Owners (creators) and org admins can edit/delete (admin inheritance —
#   mirrors mcp_server).
# - Editors (a per-resource grant) edit, tag and run it; they never delete
#   it or change who reaches it (visibility, grants).
#
# FGA tuples on creation:
# - workflow:github-summary#organization@organization:stigmer
# - workflow:github-summary#owner@identity_account:alice
# - workflow:github-summary#viewer@organization:stigmer#viewer (if visibility>=ORG)
# - workflow:github-summary#platform_viewer@identity_provider:<idp>#platform_user (if visibility=PLATFORM)
#
# Platform visibility (visibility_platform):
# - Grants view + execute to members of all orgs managed by the owning
#   org's IdentityProvider (see agent.fga for the full pattern docs).

type workflow
  relations
    # ========================================
    # ORGANIZATION OWNERSHIP
    # ========================================
    # Structural link only for viewer access — org ADMINS still inherit
    # owner through it (see owner below), so a private workflow remains
    # manageable by org admins while invisible to plain members.
    define organization: [organization]
    
    # ========================================
    # OWNERSHIP (Attribution + Admin)
    # ========================================
    define owner: ([identity_account] and affiliated from organization) or admin from organization
    
    # ========================================
    # PLATFORM VISIBILITY (Structural)
    # ========================================
    # Members of all orgs managed by the owning org's IdentityProvider.
    # FGA tuple: workflow:<id>#platform_viewer@identity_provider:<idp_id>#platform_user
    define platform_viewer: [identity_provider#platform_user]
    
    # ========================================
    # EDITOR (a grant, Enterprise and the hosted edition)
    # ========================================
    # A person or a team granted edit on this one workflow: may change its
    # definition, tag its versions and run it, and may not delete it or decide
    # who else reaches it (visibility and grants ask can_grant_access, the
    # owner's). Implies viewer. Bounded by the organization like every direct
    # grant. Only an edition that widens the policy grant scope past the
    # organization writes the row.
    # FGA tuple: workflow:<id>#editor@identity_account:<user> (or team:<id>#member)
    define editor: [identity_account, team#member] and affiliated from organization
    
    # ========================================
    # VIEWER ACCESS
    # ========================================
    # organization#viewer is the shape VisibilityTupleReconciler writes — the
    # org's FULL read audience (roles flow downward: owner/admin/member all
    # satisfy organization#viewer). organization#member is the legacy
    # pre-2026-08-11 shape, accepted so tuples written before the flip keep
    # resolving until the boot backfill converges them. team#member is an
    # Enterprise team's grant: every member, bounded by the organization
    # in team.fga.
    define viewer: ([identity_account, organization#member, organization#viewer, team#member] and affiliated from organization) or owner or editor or platform_viewer
    
    # ========================================
    # PERMISSIONS
    # ========================================
    define can_view: viewer
    define can_edit: owner or editor
    define can_delete: owner
    # Platform invariant: you can run what you can read (the execution gate
    # checks can_view; instance models define can_execute: can_view).
    define can_execute: viewer
    define can_clone: viewer
    
    # ========================================
    # IAM POLICY MANAGEMENT
    # ========================================
    define can_grant_access: owner
    define can_view_access: viewer
