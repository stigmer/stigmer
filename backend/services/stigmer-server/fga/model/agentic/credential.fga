module agentic

# ========================================
# CREDENTIAL TYPE (Organization-scoped, owned by a person or the organization)
# ========================================
# A credential is a saved set of secret values. It belongs either to a
# person ("my Linear sign-in", "my OpenAI key") or to the organization
# ("the deploy bot's AWS key"), fixed when it is created.
#
# - A PERSON'S credential: its owner uses, edits, deletes and reveals it.
#   Nobody else reaches it, the organization's admins included: it holds
#   that person's own secrets. It is never granted to anyone.
# - An ORGANIZATION'S credential: nobody owns it. The organization's
#   admins edit, delete and grant it, and their runs may use it; a `user`
#   grant lets a person or a team's members use it too. Nobody reveals it:
#   it is write-only, replaced and never read back.
#
# "Use" is what a run does with a credential: its values reach the run.
# can_use is asked when a surface (a schedule, a share link, a channel, a
# platform client) is assigned a credential, again when a run starts from
# that surface, and when a person's own run takes an organization
# credential that serves its agent or git host by default.
#
# FGA tuples on creation (both are optional parent links read from the
# spec's owner oneof, kind_meta additional_parents):
# - credential:c#organization@organization:acme
# - a person's:        credential:c#owner@identity_account:alice
# - an organization's: credential:c#org_owned@organization:acme
#
# Grants (an organization's credential only; the IamPolicy grant path):
# - credential:c#user@identity_account:bob
# - credential:c#user@team:on-call#member

type credential
  relations
    # ========================================
    # ORGANIZATION SCOPE
    # ========================================
    define organization: [organization]

    # ========================================
    # OWNER (a person's credential only)
    # ========================================
    # The person it belongs to. Not widened by admin: a person's secrets
    # are theirs alone.
    define owner: [identity_account] and affiliated from organization

    # ========================================
    # ORGANIZATION OWNERSHIP (an organization's credential only)
    # ========================================
    # Present exactly when the credential is the organization's own; its
    # admins manage it through this link. The scope link above cannot
    # serve: every credential has it, a person's included.
    define org_owned: [organization]

    # ========================================
    # USER (Explicit Grants)
    # ========================================
    # People and teams whose runs may use an organization's credential.
    # Bounded by the organization like every direct grant; a team's
    # members through team#member, bounded in team.fga.
    define user: [identity_account, team#member] and affiliated from organization

    # ========================================
    # PERMISSIONS
    # ========================================
    define can_use: owner or user or admin from org_owned
    define can_view: owner or user or admin from org_owned
    define can_edit: owner or admin from org_owned
    define can_delete: owner or admin from org_owned

    # ========================================
    # SECRET REVEAL (a person's own credential only)
    # ========================================
    define can_read_secrets: owner

    # ========================================
    # IAM POLICY MANAGEMENT
    # ========================================
    # Who may grant `user`: the organization's admins, on its own
    # credentials. A person's credential has nobody who may grant it.
    define can_grant_access: admin from org_owned
    define can_view_access: admin from org_owned
