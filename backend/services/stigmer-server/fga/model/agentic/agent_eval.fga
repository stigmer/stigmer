module agentic

# ========================================
# AGENT EVAL TYPE (Agent-bound)
# ========================================
# One run of the eval cases of the plugins an agent attaches, on the agent
# itself: each plugin's cases at the version the agent attaches, on the
# models the eval names.
#
# Authorization model:
# - The agent's editors start, cancel and delete its evals, as they own its
#   evaluator.
# - The agent's viewers in the agent's own organization read the eval and,
#   through the session link (session#agent_eval), its tries. A child
#   organization's viewer of a shared agent does not: a try spends the
#   agent organization's money and may act with its connections, the
#   plugin eval's reason (plugin_eval.fga). The model has no `but not`, so
#   agent.fga names that set `org_viewer`.
# - No owner of its own (OWNER_ATTRIBUTION_TYPE_NONE). The agent's owner
#   already includes the organization's admins, who hold the purse the
#   eval spends.

type agent_eval
  relations
    # ========================================
    # PARENT AGENT
    # ========================================
    # FGA tuple: agent_eval:<eval_id>#agent@agent:<agent_id>
    define agent: [agent]

    # ========================================
    # OPERATIONS
    # ========================================
    define viewer: org_viewer from agent
    define can_view: viewer
    define can_edit: can_edit from agent
    define can_delete: can_edit from agent
