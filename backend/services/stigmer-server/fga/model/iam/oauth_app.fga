module iam

# ========================================
# OAUTH APP TYPE (Organization-scoped)
# ========================================
# Registered OAuth applications with external vendors (Slack, Salesforce, Figma, etc.).
# Holds client credentials for vendor-specific OAuth flows.
# Scoped to organization — each OAuth app is owned by an org.
#
# Access model: RESTRICTED, managed by the organization's current admins
# OAuth apps contain the organization's client credentials with a vendor
# (client_secret), so they are the organization's credential, not a
# person's. Plain members and viewer-role members of the organization see
# nothing. `owner` is computed, never stored: it is the organization's
# admins, as an identity provider is managed, so an app stays manageable
# whoever created it, and a creator who is demoted below admin or removed
# loses control of it with the role. The creator is recorded in the audit
# trail (kind_meta `owner_type` NONE). Public visibility is intentionally
# unsupported to prevent credential leakage.
#
# Permission pattern:
# - Org Admin (and org owner, through admin): full management
# - Direct viewer grant: can see the app and who has access to it
# - Org Members and Viewers: no access (administrative resource)
#
# FGA tuple on creation (the kind's creation event: organization scope, no
# owner; private, so no visibility tuple):
# - oauth_app:oapp_abc#organization@organization:acme
#
# Checks the handlers make: `can_create_oauth_app` on the organization to
# create; `can_view` to get, get by reference, and to keep a row in the
# organization's list; `can_edit` to update; `can_delete` to delete.

type oauth_app
  relations
    # ========================================
    # PARENT ORGANIZATION
    # ========================================
    define organization: [organization]
    
    # ========================================
    # OWNERSHIP
    # ========================================
    # Every current admin of the app's organization, and nobody else.
    define owner: admin from organization
    
    # ========================================
    # VIEWER ACCESS
    # ========================================
    # Owners (admins included) and direct viewer grants. Organization
    # members and viewers are deliberately absent.
    define viewer: [identity_account] or owner
    
    # ========================================
    # PERMISSIONS
    # ========================================
    define can_view: viewer
    define can_edit: owner
    define can_delete: owner
    
    # ========================================
    # IAM POLICY MANAGEMENT
    # ========================================
    define can_grant_access: owner
    define can_view_access: viewer
