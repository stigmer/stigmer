{
  "name": "@stigmer/eval-runtime",
  "version": "0.0.0-dev",
  "description": "What a plugin eval's and the AI judge's server and runner both execute with, so the two never drift: the plugin-eval format's transcript reader, its expect dialect and a linear matcher, mock answer rendering, the wording of a try's own stops, and the AI judge's rubrics, verdict schema, message and verdict reader",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.13.0 || >=23.4.0"
  },
  "keywords": [
    "stigmer",
    "claude-code",
    "plugin-eval",
    "mocks",
    "llm-judge"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stigmer/stigmer.git",
    "directory": "backend/libs/ts/eval-runtime"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
