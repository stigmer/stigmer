{
  "name": "@stigmer/tool-vocabulary",
  "version": "0.0.0-dev",
  "description": "Claude Code's tool names as Stigmer reads them, shared by the runner and the control plane: the built-in names a tool list may carry, the tables of which Claude tools each engine tool covers (native, the Cursor hook, the Cursor SDK), and the reverse reading a grader uses to name a recorded engine call in Claude's words",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.13.0 || >=23.4.0"
  },
  "keywords": [
    "stigmer",
    "claude-code",
    "tools",
    "tool-lists"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stigmer/stigmer.git",
    "directory": "backend/libs/ts/tool-vocabulary"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
