# Example Environment Configuration
# Copy this to .env and customize for your project

# =============================================================================
# Application Configuration (Non-Sensitive)
# =============================================================================

# Deployment region
REGION=us-east-1

# Environment name (development, staging, production)
ENVIRONMENT=development

# Logging level (debug, info, warn, error)
LOG_LEVEL=info

# =============================================================================
# Service Endpoints (Non-Sensitive)
# =============================================================================

# API endpoint
API_ENDPOINT=https://api.example.com

# Database host
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=mydb

# Redis connection
REDIS_HOST=localhost
REDIS_PORT=6379

# =============================================================================
# Feature Flags (Non-Sensitive)
# =============================================================================

# Enable caching
ENABLE_CACHING=true

# Enable analytics
ENABLE_ANALYTICS=false

# Enable debug mode
DEBUG_MODE=false

# =============================================================================
# MCP Server Configuration (Non-Sensitive)
# =============================================================================

# GitHub organization or user (not a secret)
GITHUB_OWNER=my-org

# GitHub API URL (for enterprise)
GITHUB_API_URL=https://api.github.com

# Slack workspace (not a secret)
SLACK_WORKSPACE=my-workspace

# =============================================================================
# Optional Configuration
# =============================================================================

# Request timeout in seconds
REQUEST_TIMEOUT=30

# Max retries
MAX_RETRIES=3

# Notification email
NOTIFICATION_EMAIL=team@example.com

# =============================================================================
# Usage Instructions
# =============================================================================
#
# 1. Copy this file:
#    cp .env.example .env
#
# 2. Customize the values above
#
# 3. Create .env.secret for sensitive values (see .env.secret.example)
#
# 4. Run your agent/workflow:
#    stigmer run my-agent --env-file .env --secret-file .env.secret
#
# 5. Add .env to .gitignore if it contains any sensitive info
#
# For complete documentation:
# https://github.com/stigmer/stigmer/blob/main/docs/guides/environment-variables.md
