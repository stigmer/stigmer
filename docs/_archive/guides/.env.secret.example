# Example Secrets Configuration
# Copy this to .env.secret and add your actual secrets
# NEVER COMMIT .env.secret TO GIT!

# =============================================================================
# IMPORTANT: Add .env.secret to .gitignore
# =============================================================================
#
# Add this to your .gitignore:
#   .env.secret
#   .env.secret.*
#   .env.*.local
#
# =============================================================================

# =============================================================================
# API Keys and Tokens
# =============================================================================

# OpenAI API key
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-key-here

# GitHub personal access token
# Get from: https://github.com/settings/tokens
# Required scopes: repo, read:org
GITHUB_TOKEN=ghp_your-token-here

# Anthropic API key
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Slack bot token
# Get from: https://api.slack.com/apps
# Required scopes: chat:write, channels:read
SLACK_TOKEN=xoxb-your-token-here

# Stripe API key (for payment integrations)
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_API_KEY=sk_live_your-key-here

# =============================================================================
# Database Credentials
# =============================================================================

# Database password
DATABASE_PASSWORD=your-strong-password-here

# Redis password (if authentication enabled)
REDIS_PASSWORD=your-redis-password-here

# MongoDB connection string
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/mydb

# =============================================================================
# AWS Credentials (for cloud integrations)
# =============================================================================

# AWS access key
AWS_ACCESS_KEY_ID=AKIA...

# AWS secret key
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# =============================================================================
# Application Secrets
# =============================================================================

# JWT secret for token signing
JWT_SECRET=your-random-secret-value-here

# Encryption key (base64 encoded)
ENCRYPTION_KEY=your-base64-encoded-key-here

# Session secret
SESSION_SECRET=your-session-secret-here

# =============================================================================
# Third-Party Service Credentials
# =============================================================================

# SendGrid API key (for email)
SENDGRID_API_KEY=SG.your-key-here

# Twilio credentials (for SMS)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=your-auth-token

# Datadog API key (for monitoring)
DATADOG_API_KEY=your-datadog-key

# =============================================================================
# Usage Instructions
# =============================================================================
#
# 1. Copy this file:
#    cp .env.secret.example .env.secret
#
# 2. Replace placeholder values with your actual secrets
#
# 3. Verify .env.secret is in .gitignore:
#    grep .env.secret .gitignore
#
# 4. Use with stigmer run:
#    stigmer run my-agent --secret-file .env.secret
#
# 5. Combine with .env for complete configuration:
#    stigmer run my-agent --env-file .env --secret-file .env.secret
#
# 6. Override for testing:
#    stigmer run my-agent \
#      --secret-file .env.secret \
#      --secret "OPENAI_API_KEY=sk-test-key"
#
# =============================================================================
# Security Best Practices
# =============================================================================
#
# ✓ DO:
#   - Add .env.secret to .gitignore
#   - Use separate secrets for development/production
#   - Rotate secrets regularly
#   - Use strong, unique values
#   - Share secrets securely (1Password, Vault, etc.)
#
# ✗ DON'T:
#   - Commit .env.secret to version control
#   - Share secrets via email/Slack
#   - Use same secrets across environments
#   - Hardcode secrets in code
#   - Use weak or default values
#
# For complete security documentation:
# https://github.com/stigmer/stigmer/blob/main/docs/guides/environment-variables.md#security-considerations
