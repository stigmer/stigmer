# Stigmer self-host compose stack — environment template.
#
#   cp .env.example .env
#
# then fill in the three REQUIRED values below. `docker compose up` fails
# loudly until they exist — that is deliberate (DD-013): keys that
# materialize implicitly make the backup and rotation story invisible
# exactly where a self-hoster needs it explicit.
#
# BACKUP STORY — the complete durable state of this stack is:
#   the postgres-data volume + the artifacts volume + the server-data
#   volume + THIS FILE. Losing the two STIGMER_* keys below strands every
#   encrypted value in the database, so back this file up like a key file.

# ── Required ────────────────────────────────────────────────────────────────

# Postgres superuser password (the stack's internal database; not exposed
# on the host). Any strong secret:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Encrypts secret values at rest (environment variables, OAuth tokens).
# Base64-encoded 32 bytes — generate with:
#   openssl rand -base64 32
STIGMER_ENCRYPTION_KEY=

# Signs the execution-scoped tokens the runner authenticates with.
# Base64-encoded 32 bytes — generate with:
#   openssl rand -base64 32
STIGMER_RUNNER_TOKEN_KEY=

# ── Optional ────────────────────────────────────────────────────────────────

# LLM provider key for agent executions (Anthropic is the provider local
# execution supports). Without it the stack still serves the console, the
# API, and LLM-free workflow executions; agent runs will fail at the LLM
# call.
#ANTHROPIC_API_KEY=

# Cursor API key, only for agents on the Cursor harness.
#CURSOR_API_KEY=

# Operator identity, stamped into audit slots on resources you create.
#STIGMER_OPERATOR_EMAIL=you@example.com
#STIGMER_OPERATOR_NAME=Your Name

# Run a specific released stack version (both images move together; the
# default pin in docker-compose.yml is bumped in each release commit).
#STIGMER_VERSION=v3.24.0

# ── Reachable from other machines ───────────────────────────────────────────
#
# The stack mints URLs for browsers and the CLI: skill transfer URLs from
# the API address, download links from the artifact lane's address. The
# defaults are this machine's published ports. Behind a TLS proxy, set both
# to the addresses your clients reach; serve the API on port 443, which is
# the one port the CLI dials with TLS.
#STIGMER_PUBLIC_URL=https://stigmer.example.com
#STIGMER_ARTIFACT_PUBLIC_URL=https://artifacts.stigmer.example.com

# ── Authentication ──────────────────────────────────────────────────────────
#
# Off until the issuer is set; then every caller needs a credential. Issuer
# and audience go together (the server refuses one without the other). The
# console client id is the public PKCE client you register with your
# provider for the web console. The authentication guide has the provider
# steps and the order to mint API keys:
#   https://stigmer.ai/docs/guides/self-hosting/authentication
#STIGMER_OIDC_ISSUER=https://auth.example.com/realms/main
#STIGMER_OIDC_AUDIENCE=https://stigmer.example.com
#STIGMER_OIDC_CONSOLE_CLIENT_ID=stigmer-console

# The runner's own API key, created without an expiry so it does not stop
# working one day (stigmer apikey create --name runner --never-expires, or
# Settings → API Keys in the console). The authentication guide says when to
# set it; an empty value is unset.
#STIGMER_TOKEN=
