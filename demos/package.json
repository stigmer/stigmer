{
  "name": "@stigmer/demos",
  "version": "0.0.0-dev",
  "private": true,
  "type": "module",
  "description": "Source for Stigmer's hosted Scenar product tours. Tours are authored here against the in-repo @stigmer/* SDK source, packed into self-contained static embeds by @scenar/cli, and shipped with the website release at https://stigmer.ai/demos/<tour>/.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "narrate": "NODE_OPTIONS=--import=tsx scenar narrate tours --tts edge-tts",
    "pack": "scenar pack",
    "pack-all": "node scripts/pack-all.mjs",
    "serve": "scenar serve"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.0",
    "@connectrpc/connect": "^2.1.2",
    "@scenar/core": "^0.8.0",
    "@scenar/react": "^0.8.0",
    "@stigmer/protos": "*",
    "@stigmer/react": "*",
    "@stigmer/sdk": "*",
    "@stigmer/theme": "*",
    "framer-motion": "^12.38.0",
    "lucide-react": ">=0.400.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@scenar/cli": "^0.8.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "edge-tts-universal": "^1.4.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
