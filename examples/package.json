{
  "name": "@stigmer/examples",
  "version": "0.0.0-dev",
  "description": "Stigmer's example agents as one list: each a job an agent does for a product's users, with its agent, its sample files and its first message, read by the React kit's launcher and its create picker",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./journey": {
      "types": "./dist/journey/index.d.ts",
      "import": "./dist/journey/index.js",
      "default": "./dist/journey/index.js"
    }
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "node scripts/generate.mjs --check && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.13.0 || >=23.4.0"
  },
  "keywords": [
    "stigmer",
    "agents",
    "examples"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./journey": {
        "types": "./dist/journey/index.d.ts",
        "import": "./dist/journey/index.js",
        "default": "./dist/journey/index.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stigmer/stigmer.git",
    "directory": "examples"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "typescript": "^5.7.0",
    "yaml": "2.9.0"
  }
}
