  "struck": [
    {
      "source": "cursor-plugins",
      "name": "google-cloud-bigquery",
      "reason": "asks for OAuth only at the tool call, against a login server (accounts.google.com) that does not register clients dynamically; nothing at save or at connect can see the challenge, and Sign in could not complete; enters when Stigmer holds an OAuth app registered with Google"
    },
    {
      "source": "cursor-plugins",
      "name": "orchestrate",
      "reason": "carries a .gitignore, which npm consumes as packing rules rather than publishing, so the released package would not be the tree; enters when the plugin selection leaves ignore files out of the archive"
    }
  ]
}
