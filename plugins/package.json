{
  "name": "@stigmer/plugins",
  "version": "0.0.0-dev",
  "description": "Stigmer's official plugin marketplace: a directory tree of Agent Plugins packages with a root marketplace.json, published at the CLI's own version so what `stigmer install` installs matches the control plane that serves it",
  "license": "Apache-2.0",
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/stage-content.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "audit": "tsx scripts/audit/main.ts",
    "sync": "tsx scripts/sync/main.ts",
    "refresh-body": "tsx scripts/sync/refresh-body.ts"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "stigmer",
    "agent-plugins",
    "marketplace",
    "plugins",
    "skills",
    "mcp"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stigmer/stigmer.git",
    "directory": "plugins"
  },
  "devDependencies": {
    "@stigmer/outbound": "*",
    "@stigmer/plugin-package": "*",
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4",
    "yaml": "^2.8.2"
  }
}
